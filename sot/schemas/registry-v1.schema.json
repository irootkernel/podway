{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:registry:v1",
  "title": "Podway Minimal Workspace Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspaces"
  ],
  "properties": {
    "schema": {
      "const": "podway.registry/v1"
    },
    "workspaces": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace_uuid",
          "last_known_root",
          "last_seen_at"
        ],
        "properties": {
          "workspace_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "last_known_root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
