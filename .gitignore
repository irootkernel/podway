.DS_Store
# Cargo build output
/target/
**/target/

# Podway local runtime state and SQLite sidecars
*.sqlite3-shm
*.sqlite3-wal

# Mulgae shared policy and local state
/.mulgae/*
!/.mulgae/config.yaml

# Gaori portable policy and local state
/.gaori/*
!/.gaori/tester.yaml
!/.gaori/tester/
/.gaori/tester/*
!/.gaori/tester/rules/
/.gaori/tester/rules/*
!/.gaori/tester/rules/*.yaml

# Project-local Codex MCP configuration
/.codex/config.toml

# Test, coverage, and temporary artifacts
/coverage/
/dist/
*.lcov
/artifacts/
/fuzz/artifacts/
/fuzz/corpus/
*.log
*.swp
*.tmp
*.temp
*~

# Keep SOT, executable contracts, and stable contract evidence versioned;
# never ignore docs/ or contracts/.

# Python caches and bytecode
/.ruff_cache/
__pycache__/
*.py[cod]
