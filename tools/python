#!/bin/sh
# Bootstrap without depending on whichever python3 happens to be on PATH.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
version=$(cat "$root/.python-version")
if ! printf '%s\n' "$version" | LC_ALL=C grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
    echo '.python-version must contain one exact Python patch version' >&2
    exit 1
fi
if ! command -v uv >/dev/null 2>&1; then
    echo 'uv is required to locate the pinned Python interpreter' >&2
    exit 1
fi
if ! interpreter=$(uv python find --system --no-project --no-config --no-python-downloads --resolve-links "$version"); then
    echo "Python $version is required; install that exact version before running project tools" >&2
    exit 1
fi
observed=$("$interpreter" -I -c 'import platform; print(platform.python_version())')
if [ "$observed" != "$version" ]; then
    echo "Python $version is required, observed $observed" >&2
    exit 1
fi
exec "$interpreter" "$@"
