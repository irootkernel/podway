{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:job-wait-timeout-details:v1",
  "title": "Podway Job Wait Timeout Details v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": { "const": "podway.job-wait-timeout-details/v1" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "admission"],
      "properties": {
        "schema": { "const": "podway.job-wait-timeout-details/v1" },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["admitted"],
          "properties": { "admitted": { "const": false } }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "job_id", "job_sequence", "admission"],
      "properties": {
        "schema": { "const": "podway.job-wait-timeout-details/v1" },
        "job_id": { "type": "string", "format": "uuid" },
        "job_sequence": { "type": "integer", "minimum": 1 },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["admitted", "job_id", "workspace_sequence"],
          "properties": {
            "admitted": { "const": true },
            "job_id": { "type": "string", "format": "uuid" },
            "workspace_sequence": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  ]
}
