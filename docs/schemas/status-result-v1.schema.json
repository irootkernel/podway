{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:status-result:v1",
  "title": "Podway Status Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "session",
    "current",
    "stages",
    "items",
    "blockers",
    "queue"
  ],
  "properties": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "procedure"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "procedure": {
          "type": "object",
        "additionalProperties": false,
          "required": [
            "id",
            "version",
            "name",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lifecycle",
        "revision",
        "created_at",
        "completed_at",
        "cancelled_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "lifecycle": {
          "enum": [
            "running",
            "completed",
            "cancelled"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "cancelled_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "current": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage_id",
            "stage_index",
            "title",
            "attempt_id",
            "attempt_number",
            "blocked",
            "ready_to_complete"
          ],
          "properties": {
            "stage_id": {
              "type": "string"
            },
            "stage_index": {
              "type": "integer",
              "minimum": 0
            },
            "title": {
              "type": "string"
            },
            "attempt_id": {
              "type": "string",
              "format": "uuid"
            },
            "attempt_number": {
              "type": "integer",
              "minimum": 1
            },
            "blocked": {
              "type": "boolean"
            },
            "ready_to_complete": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "previous_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "attempt_id",
          "attempt_number",
          "lifecycle",
          "started_at",
          "ended_at",
          "reason"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "attempt_number": {
            "type": "integer",
            "minimum": 1
          },
          "lifecycle": {
            "enum": [
              "active",
              "completed",
              "skipped",
              "abandoned"
            ]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "index",
          "title",
          "status",
          "latest_attempt_number"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "current",
              "blocked",
              "done",
              "skipped",
              "redo",
              "abandoned"
            ]
          },
          "latest_attempt_number": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
          "additionalProperties": false,
        "required": [
          "id",
          "type",
          "prompt",
          "required",
          "satisfied",
          "revision",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "confirm",
              "text",
              "choice",
              "integer",
              "list",
              "artifact"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "satisfied": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "value": {}
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "attempt_id", "reason"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "attempt_id": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending_mutations",
        "queued_count",
        "running_job_id",
        "latest_workspace_sequence"
      ],
      "properties": {
        "pending_mutations": {
          "type": "boolean"
        },
        "queued_count": {
          "type": "integer",
          "minimum": 0
        },
        "running_job_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "latest_workspace_sequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
