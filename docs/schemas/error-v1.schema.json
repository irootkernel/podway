{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:error:v1",
  "title": "Podway Error Output v1",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "notAdmitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted"],
      "properties": {
        "admitted": { "const": false }
      }
    },
    "admitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted", "job_id", "workspace_sequence"],
      "properties": {
        "admitted": { "const": true },
        "job_id": { "type": "string", "format": "uuid" },
        "workspace_sequence": { "type": "integer", "minimum": 1 }
      }
    },
    "admission": {
      "oneOf": [
        { "$ref": "#/$defs/notAdmitted" },
        { "$ref": "#/$defs/admitted" }
      ]
    },
    "workspaceUuidMismatchDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "expected_workspace_uuid",
        "actual_workspace_uuid",
        "admission"
      ],
      "properties": {
        "schema": { "const": "podway.workspace-uuid-mismatch-details/v1" },
        "expected_workspace_uuid": { "type": "string", "format": "uuid" },
        "actual_workspace_uuid": { "type": "string", "format": "uuid" },
        "admission": { "$ref": "#/$defs/admission" }
      }
    },
    "sessionIdMismatchDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "expected_session_id",
        "actual_session_id",
        "admission"
      ],
      "properties": {
        "schema": { "const": "podway.session-id-mismatch-details/v1" },
        "expected_session_id": { "type": "string", "format": "uuid" },
        "actual_session_id": {
          "oneOf": [
            { "type": "string", "format": "uuid" },
            { "type": "null" }
          ]
        },
        "admission": { "$ref": "#/$defs/admission" }
      }
    },
    "procedureDigestMismatchDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "expected_procedure_digest",
        "actual_procedure_digest",
        "admission"
      ],
      "properties": {
        "schema": { "const": "podway.procedure-digest-mismatch-details/v1" },
        "expected_procedure_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "actual_procedure_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "admission": { "$ref": "#/$defs/notAdmitted" }
      }
    },
    "mutationOutcomeUnknownDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "outcome", "idempotency_key", "reconcile"],
      "properties": {
        "schema": { "const": "podway.mutation-outcome-unknown-details/v1" },
        "outcome": { "const": "unknown" },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reconcile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "idempotency_key"],
          "properties": {
            "command": { "const": "job.lookup" },
            "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "request_id",
    "command",
    "generated_at",
    "code",
    "message",
    "retryable",
    "exit_code",
    "details"
  ],
  "properties": {
    "schema": {
      "const": "podway.error/v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "exit_code": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "workspace": {
      "type": "object"
    },
    "details": {
      "type": "object",
      "properties": {
        "admission": {
          "$ref": "#/$defs/admission"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "code": { "const": "WORKSPACE_UUID_MISMATCH" } },
        "required": ["code"]
      },
      "then": {
        "properties": {
          "details": { "$ref": "#/$defs/workspaceUuidMismatchDetails" }
        }
      }
    },
    {
      "if": {
        "properties": { "code": { "const": "SESSION_ID_MISMATCH" } },
        "required": ["code"]
      },
      "then": {
        "properties": {
          "details": { "$ref": "#/$defs/sessionIdMismatchDetails" }
        }
      }
    },
    {
      "if": {
        "properties": { "code": { "const": "PROCEDURE_DIGEST_MISMATCH" } },
        "required": ["code"]
      },
      "then": {
        "properties": {
          "details": { "$ref": "#/$defs/procedureDigestMismatchDetails" }
        }
      }
    },
    {
      "if": {
        "properties": { "code": { "const": "MUTATION_OUTCOME_UNKNOWN" } },
        "required": ["code"]
      },
      "then": {
        "properties": {
          "details": { "$ref": "#/$defs/mutationOutcomeUnknownDetails" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "enum": [
              "DAEMON_NOT_INSTALLED",
              "DAEMON_UNAVAILABLE",
              "DAEMON_SHUTTING_DOWN",
              "DAEMON_VERSION_INCOMPATIBLE"
            ]
          }
        },
        "required": ["code"]
      },
      "then": {
        "properties": {
          "details": { "$ref": "urn:podway:schema:endpoint-error-details:v1" }
        }
      }
    },
    {
      "if": {
        "properties": { "code": { "const": "DAEMON_CONTRACT_MISMATCH" } },
        "required": ["code"]
      },
      "then": {
        "properties": {
          "details": { "$ref": "urn:podway:schema:daemon-contract-mismatch-details:v1" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "enum": ["SESSION_REVISION_CONFLICT", "ITEM_REVISION_CONFLICT"]
          }
        },
        "required": ["code"]
      },
      "then": {
        "properties": {
          "details": { "$ref": "urn:podway:schema:revision-conflict-details:v1" }
        }
      }
    },
    {
      "if": {
        "properties": { "code": { "const": "ATTEMPT_NOT_CURRENT" } },
        "required": ["code"]
      },
      "then": {
        "properties": {
          "details": { "$ref": "urn:podway:schema:attempt-conflict-details:v1" }
        }
      }
    },
    {
      "if": {
        "properties": { "code": { "const": "IDEMPOTENCY_KEY_REUSED" } },
        "required": ["code"]
      },
      "then": {
        "properties": {
          "details": { "$ref": "urn:podway:schema:idempotency-key-reused-details:v1" }
        }
      }
    },
    {
      "if": {
        "properties": { "code": { "const": "JOB_WAIT_TIMEOUT" } },
        "required": ["code"]
      },
      "then": {
        "properties": {
          "details": { "$ref": "urn:podway:schema:job-wait-timeout-details:v1" }
        }
      }
    },
    {
      "if": {
        "properties": { "code": { "const": "BLOCKER_LIMIT_REACHED" } },
        "required": ["code"]
      },
      "then": {
        "properties": {
          "details": { "$ref": "urn:podway:schema:blocker-limit-details:v1" }
        }
      }
    }
  ]
}
