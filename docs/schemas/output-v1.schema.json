{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:output:v1",
  "title": "Podway Success Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "command",
    "generated_at",
    "result",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "podway.output/v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "job": {
      "$ref": "#/$defs/job"
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "result": {
      "type": "object",
      "properties": {
        "admission": {
          "$ref": "#/$defs/admitted"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "command": { "const": "version" } }, "required": ["command"] },
      "then": { "properties": { "result": { "$ref": "urn:podway:schema:version-result:v1" } } }
    },
    {
      "if": { "properties": { "command": { "const": "daemon.status" } }, "required": ["command"] },
      "then": { "properties": { "result": { "$ref": "urn:podway:schema:daemon-status-result:v1" } } }
    },
    {
      "if": { "properties": { "command": { "const": "procedure.validate" } }, "required": ["command"] },
      "then": { "properties": { "result": { "$ref": "urn:podway:schema:procedure-validation-result:v1" } } }
    },
    {
      "if": { "properties": { "command": { "const": "session.status" } }, "required": ["command"] },
      "then": {
        "properties": {
          "result": {
            "oneOf": [
              {"$ref": "urn:podway:schema:status-result:v1"},
              {"$ref": "urn:podway:schema:compact-status-result:v1"}
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "session.next" } }, "required": ["command"] },
      "then": { "properties": { "result": { "$ref": "urn:podway:schema:next-result:v1" } } }
    },
    {
      "if": { "properties": { "command": { "enum": ["job.status", "job.wait"] } }, "required": ["command"] },
      "then": { "properties": { "result": { "$ref": "urn:podway:schema:job-result:v1" } } }
    },
    {
      "if": { "properties": { "command": { "const": "job.lookup" } }, "required": ["command"] },
      "then": { "properties": { "result": { "$ref": "urn:podway:schema:job-lookup-result:v1" } } }
    },
    {
      "if": {
        "properties": {
          "result": {
            "type": "object",
            "anyOf": [
              { "required": ["detached"] },
              { "properties": { "schema": { "const": "podway.detached-admission-result/v1" } }, "required": ["schema"] }
            ]
          }
        },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "command": {
            "enum": ["workspace.init", "session.start", "session.start_replace", "session.complete", "session.skip", "session.retry", "session.return", "session.block", "session.unblock", "session.cancel", "session.reopen", "session.reset", "item.check", "item.uncheck", "item.set", "item.add", "item.remove", "item.attach", "item.clear"]
          },
          "result": { "$ref": "urn:podway:schema:detached-admission-result:v1" }
        },
        "allOf": [
          {
            "if": { "properties": { "command": { "enum": ["session.start", "session.start_replace"] } }, "required": ["command"] },
            "then": { "properties": { "result": { "required": ["procedure_digest"] } } },
            "else": { "properties": { "result": { "not": { "required": ["procedure_digest"] } } } }
          }
        ]
      },
      "else": {
        "allOf": [
          {
            "if": { "properties": { "command": { "enum": ["session.start", "session.start_replace"] } }, "required": ["command"] },
            "then": { "properties": { "result": { "$ref": "urn:podway:schema:session-start-result:v1" } } }
          },
          {
            "if": { "properties": { "command": { "enum": ["item.check", "item.uncheck", "item.set", "item.add", "item.remove", "item.attach", "item.clear"] } }, "required": ["command"] },
            "then": { "properties": { "result": { "$ref": "urn:podway:schema:item-mutation-result:v1" } } }
          },
          {
            "if": { "properties": { "command": { "enum": ["session.complete", "session.skip", "session.retry", "session.return", "session.block", "session.unblock", "session.cancel", "session.reopen", "session.reset"] } }, "required": ["command"] },
            "then": {
              "properties": { "result": { "$ref": "urn:podway:schema:stage-transition-result:v1" } },
              "if": { "properties": { "command": { "const": "session.reset" } } },
              "else": { "properties": { "result": { "not": { "required": ["reset"] } } } }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "schema": {
                "enum": [
                  "podway.version-result/v1", "podway.daemon-status-result/v1",
                  "podway.procedure-validation-result/v1", "podway.detached-admission-result/v1",
                  "podway.session-start-result/v1", "podway.status-result/v1",
                  "podway.compact-status-result/v1", "podway.next-result/v1",
                  "podway.stage-transition-result/v1", "podway.item-mutation-result/v1",
                  "podway.job-lookup-result/v1", "podway.job-result/v1"
                ]
              }
            },
            "required": ["schema"]
          }
        },
        "required": ["result"]
      },
      "then": {
        "oneOf": [
          { "properties": { "command": { "const": "version" }, "result": { "properties": { "schema": { "const": "podway.version-result/v1" } } } } },
          { "properties": { "command": { "const": "daemon.status" }, "result": { "properties": { "schema": { "const": "podway.daemon-status-result/v1" } } } } },
          { "properties": { "command": { "const": "procedure.validate" }, "result": { "properties": { "schema": { "const": "podway.procedure-validation-result/v1" } } } } },
          { "properties": { "command": { "enum": ["workspace.init", "session.start", "session.start_replace", "session.complete", "session.skip", "session.retry", "session.return", "session.block", "session.unblock", "session.cancel", "session.reopen", "session.reset", "item.check", "item.uncheck", "item.set", "item.add", "item.remove", "item.attach", "item.clear"] }, "result": { "properties": { "schema": { "const": "podway.detached-admission-result/v1" } } } } },
          { "properties": { "command": { "enum": ["session.start", "session.start_replace"] }, "result": { "properties": { "schema": { "const": "podway.session-start-result/v1" } } } } },
          { "properties": { "command": { "const": "session.status" }, "result": { "properties": { "schema": { "enum": ["podway.status-result/v1", "podway.compact-status-result/v1"] } } } } },
          { "properties": { "command": { "const": "session.next" }, "result": { "properties": { "schema": { "const": "podway.next-result/v1" } } } } },
          { "properties": { "command": { "enum": ["session.complete", "session.skip", "session.retry", "session.return", "session.block", "session.unblock", "session.cancel", "session.reopen", "session.reset"] }, "result": { "properties": { "schema": { "const": "podway.stage-transition-result/v1" } } } } },
          { "properties": { "command": { "enum": ["item.check", "item.uncheck", "item.set", "item.add", "item.remove", "item.attach", "item.clear"] }, "result": { "properties": { "schema": { "const": "podway.item-mutation-result/v1" } } } } },
          { "properties": { "command": { "const": "job.lookup" }, "result": { "properties": { "schema": { "const": "podway.job-lookup-result/v1" } } } } },
          { "properties": { "command": { "enum": ["job.status", "job.wait"] }, "result": { "properties": { "schema": { "const": "podway.job-result/v1" } } } } }
        ]
      }
    }
  ],
  "$defs": {
    "admitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted",
        "job_id",
        "workspace_sequence"
      ],
      "properties": {
        "admitted": {
          "const": true
        },
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "workspace_sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "root",
        "latest_workspace_sequence"
      ],
      "properties": {
        "uuid": {
          "type": "string",
          "format": "uuid"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "latest_workspace_sequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "state",
        "submitted_at",
        "finished_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "claimed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "lifecycle",
        "revision_before",
        "revision_after"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "running",
            "completed",
            "cancelled"
          ]
        },
        "revision_before": {
          "type": "integer",
          "minimum": 0
        },
        "revision_after": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
