{
  "schema_version": "podway.canonicalization-rules/v1",
  "canonical_json": {
    "identity": "podway.canonical-json/v1",
    "encoding": "utf-8",
    "object_keys": "unicode-scalar-lexicographic",
    "arrays": "preserve-order",
    "strings": "preserve-code-points",
    "numbers": "signed-integers-only",
    "whitespace": "none",
    "digest": "sha256-of-canonical-bytes"
  },
  "procedure": {
    "parse": "yaml-or-json",
    "reject_duplicate_keys": true,
    "reject_noncanonical_numbers": true,
    "expand_defaults_before_canonicalization": true,
    "omit_disallowed_skip_policy": true
  }
}
