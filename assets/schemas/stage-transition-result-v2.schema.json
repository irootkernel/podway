{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:stage-transition-result:v2",
  "title": "Podway Graph Transition Result v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "admission", "transition", "revision"],
  "properties": {
    "schema": { "const": "podway.stage-transition-result/v2" },
    "admission": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/admission" },
    "transition": { "enum": ["complete", "skip", "retry", "block", "unblock", "cancel", "reset"] },
    "from_graph_node_id": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" },
    "from_attempt_id": { "type": "string", "format": "uuid" },
    "to_graph_node_id": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" },
    "to_attempt_id": { "type": "string", "format": "uuid" },
    "blocker_id": { "type": "string", "format": "uuid" }, "all": { "const": true },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "reset": { "const": true },
    "revision": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/sessionRevision" },
    "session_state": { "enum": ["running", "completed", "cancelled"] }
  },
  "allOf": [
    {
      "if": { "properties": { "admission": { "properties": { "admitted": { "const": false } }, "required": ["admitted"] } }, "required": ["admission"] },
      "then": { "properties": { "transition": { "const": "reset" } } }
    }
  ],
  "oneOf": [
    { "properties": { "transition": { "const": "complete" }, "session_state": { "const": "running" } }, "required": ["from_graph_node_id", "from_attempt_id", "to_graph_node_id", "to_attempt_id", "session_state"], "not": { "anyOf": [{ "required": ["reason"] }, { "required": ["blocker_id"] }, { "required": ["all"] }, { "required": ["reset"] }] } },
    { "properties": { "transition": { "const": "complete" }, "session_state": { "const": "completed" } }, "required": ["from_graph_node_id", "from_attempt_id", "session_state"], "not": { "anyOf": [{ "required": ["to_graph_node_id"] }, { "required": ["to_attempt_id"] }, { "required": ["reason"] }, { "required": ["blocker_id"] }, { "required": ["all"] }, { "required": ["reset"] }] } },
    { "properties": { "transition": { "const": "skip" }, "session_state": { "const": "running" } }, "required": ["from_graph_node_id", "from_attempt_id", "to_graph_node_id", "to_attempt_id", "session_state"], "not": { "anyOf": [{ "required": ["blocker_id"] }, { "required": ["all"] }, { "required": ["reset"] }] } },
    { "properties": { "transition": { "const": "skip" }, "session_state": { "const": "completed" } }, "required": ["from_graph_node_id", "from_attempt_id", "session_state"], "not": { "anyOf": [{ "required": ["to_graph_node_id"] }, { "required": ["to_attempt_id"] }, { "required": ["blocker_id"] }, { "required": ["all"] }, { "required": ["reset"] }] } },
    { "properties": { "transition": { "const": "retry" }, "session_state": { "const": "running" } }, "required": ["from_graph_node_id", "from_attempt_id", "to_graph_node_id", "to_attempt_id", "reason", "session_state"], "not": { "anyOf": [{ "required": ["blocker_id"] }, { "required": ["all"] }, { "required": ["reset"] }] } },
    { "properties": { "transition": { "const": "block" }, "session_state": { "const": "running" }, "reason": { "maxLength": 1000 } }, "required": ["from_graph_node_id", "from_attempt_id", "blocker_id", "reason", "session_state"], "not": { "anyOf": [{ "required": ["to_graph_node_id"] }, { "required": ["to_attempt_id"] }, { "required": ["all"] }, { "required": ["reset"] }] } },
    { "properties": { "transition": { "const": "unblock" }, "session_state": { "const": "running" } }, "required": ["from_graph_node_id", "from_attempt_id", "blocker_id", "session_state"], "not": { "anyOf": [{ "required": ["to_graph_node_id"] }, { "required": ["to_attempt_id"] }, { "required": ["reason"] }, { "required": ["all"] }, { "required": ["reset"] }] } },
    { "properties": { "transition": { "const": "unblock" }, "session_state": { "const": "running" } }, "required": ["from_graph_node_id", "from_attempt_id", "all", "session_state"], "not": { "anyOf": [{ "required": ["to_graph_node_id"] }, { "required": ["to_attempt_id"] }, { "required": ["reason"] }, { "required": ["blocker_id"] }, { "required": ["reset"] }] } },
    { "properties": { "transition": { "const": "cancel" }, "session_state": { "const": "cancelled" } }, "required": ["from_graph_node_id", "from_attempt_id", "session_state"], "not": { "anyOf": [{ "required": ["to_graph_node_id"] }, { "required": ["to_attempt_id"] }, { "required": ["reason"] }, { "required": ["blocker_id"] }, { "required": ["all"] }, { "required": ["reset"] }] } },
    { "properties": { "transition": { "const": "reset" } }, "required": ["reset"], "not": { "anyOf": [{ "required": ["from_graph_node_id"] }, { "required": ["from_attempt_id"] }, { "required": ["to_graph_node_id"] }, { "required": ["to_attempt_id"] }, { "required": ["reason"] }, { "required": ["blocker_id"] }, { "required": ["all"] }, { "required": ["session_state"] }] } }
  ]
}
