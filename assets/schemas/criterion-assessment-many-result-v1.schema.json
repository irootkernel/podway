{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:criterion-assessment-many-result:v1",
  "title": "Podway Atomic Criterion Assessment Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "graph_node_id",
    "attempt_id",
    "goal_revision",
    "mode",
    "results",
    "complete",
    "revision"
  ],
  "properties": {
    "schema": {
      "const": "podway.criterion-assessment-many-result/v1"
    },
    "graph_node_id": {
      "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/identifier"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "goal_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "mode": {
      "enum": [
        "assessment",
        "applicability"
      ]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/criterionResult"
      }
    },
    "complete": {
      "type": "boolean"
    },
    "determined_outcome": {
      "enum": [
        "achieved",
        "not_achieved",
        "superseded"
      ]
    },
    "revision": {
      "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/runningSessionRevision"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "assessment"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "satisfied",
                    "unsatisfied"
                  ]
                }
              }
            }
          },
          "determined_outcome": {
            "enum": [
              "achieved",
              "not_achieved"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "applicability"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "properties": {
                "status": {
                  "const": "not_applicable"
                },
                "citations": {
                  "maxItems": 0
                }
              }
            }
          },
          "determined_outcome": {
            "const": "superseded"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          },
          "results": {
            "contains": {
              "properties": {
                "status": {
                  "const": "unsatisfied"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        },
        "required": [
          "complete",
          "results"
        ]
      },
      "then": {
        "properties": {
          "determined_outcome": {
            "const": "not_achieved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "required": [
          "determined_outcome"
        ]
      },
      "else": {
        "not": {
          "required": [
            "determined_outcome"
          ]
        }
      }
    }
  ],
  "$comment": "Reserved by AGENT-001 under ADR-0043; result contract for goal.assess_criteria."
}
