{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:output:v3",
  "title": "Podway Success Output v3",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "request_id", "command", "generated_at", "result", "warnings"],
  "properties": {
    "schema": { "const": "podway.output/v3" },
    "request_id": { "type": "string", "format": "uuid" },
    "command": { "type": "string", "minLength": 1, "maxLength": 128 },
    "generated_at": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/timestamp" },
    "workspace": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/workspace" },
    "job": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/job" },
    "session": { "$ref": "urn:podway:schema:v2-result-components:v2#/$defs/sessionOutput" },
    "result": { "type": "object" },
    "warnings": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/warnings" }
  },
  "oneOf": [
    { "$ref": "#/$defs/procedureIndependent" },
    { "$ref": "#/$defs/version" },
    { "$ref": "#/$defs/daemonStatus" },
    { "$ref": "#/$defs/workspaceInit" },
    { "$ref": "#/$defs/procedureValidation" },
    { "$ref": "#/$defs/detachedAdmission" },
    { "$ref": "#/$defs/sessionStart" },
    { "$ref": "#/$defs/sessionBegin" },
    { "$ref": "#/$defs/terminalDisposition" },
    { "$ref": "#/$defs/sessionReset" },
    { "$ref": "#/$defs/status" },
    { "$ref": "#/$defs/compactStatus" },
    { "$ref": "#/$defs/next" },
    { "$ref": "#/$defs/observation" },
    { "$ref": "#/$defs/stageTransition" },
    { "$ref": "#/$defs/itemMutation" },
    { "$ref": "#/$defs/itemRecordMany" },
    { "$ref": "#/$defs/jobLookup" },
    { "$ref": "#/$defs/jobResult" },
    { "$ref": "#/$defs/procedureSource" },
    { "$ref": "#/$defs/procedureDiagnostics" },
    { "$ref": "#/$defs/procedureGraph" },
    { "$ref": "#/$defs/procedurePreview" },
    { "$ref": "#/$defs/decision" },
    { "$ref": "#/$defs/rework" },
    { "$ref": "#/$defs/goalDefinition" },
    { "$ref": "#/$defs/goalRevision" },
    { "$ref": "#/$defs/criterionAssessment" }
  ],
  "$defs": {
    "procedureIndependent": {
      "properties": {
        "command": {
          "enum": ["help", "completions", "preset.list", "preset.show", "preset.explain", "procedure.show", "daemon.install", "daemon.uninstall", "daemon.start", "daemon.stop", "daemon.restart", "daemon.logs", "daemon.terminate", "workspace.show", "workspace.doctor", "workspace.repair", "workspace.reset_all", "job.list", "job.cancel", "__complete"]
        },
        "result": { "type": "object" }
      }
    },
    "version": {
      "properties": {
        "command": { "const": "version" },
        "result": { "$ref": "urn:podway:schema:version-result:v1" }
      },
      "not": {
        "anyOf": [
          { "required": ["workspace"] },
          { "required": ["job"] },
          { "required": ["session"] }
        ]
      }
    },
    "daemonStatus": {
      "properties": {
        "command": { "const": "daemon.status" },
        "result": { "$ref": "urn:podway:schema:daemon-status-result:v1" }
      },
      "not": {
        "anyOf": [
          { "required": ["workspace"] },
          { "required": ["job"] },
          { "required": ["session"] }
        ]
      }
    },
    "workspaceInit": {
      "required": ["workspace", "job"],
      "properties": {
        "command": { "const": "workspace.init" },
        "result": {
          "oneOf": [
            { "$ref": "urn:podway:schema:workspace-init-result:v1" },
            { "$ref": "urn:podway:schema:detached-admission-result:v1" }
          ]
        }
      },
      "not": { "required": ["session"] }
    },
    "terminalMutationOutput": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "request_id", "command", "generated_at", "result", "warnings"],
      "properties": {
        "schema": { "const": "podway.output/v3" },
        "request_id": { "type": "string", "format": "uuid" },
        "command": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generated_at": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/timestamp" },
        "workspace": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/workspace" },
        "job": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/job" },
        "session": { "$ref": "urn:podway:schema:v2-result-components:v2#/$defs/sessionOutput" },
        "result": { "type": "object" },
        "warnings": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/warnings" }
      },
      "oneOf": [
        { "$ref": "#/$defs/workspaceInitTerminalMutation" },
        { "$ref": "#/$defs/workspaceResetAllTerminalMutation" },
        { "$ref": "#/$defs/sessionStartMutation" },
        { "$ref": "#/$defs/sessionBegin" },
        { "$ref": "#/$defs/terminalDisposition" },
        { "$ref": "#/$defs/sessionReset" },
        { "$ref": "#/$defs/stageTransition" },
        { "$ref": "#/$defs/itemMutation" },
        { "$ref": "#/$defs/itemRecordMany" },
        { "$ref": "#/$defs/decision" },
        { "$ref": "#/$defs/rework" },
        { "$ref": "#/$defs/goalDefinition" },
        { "$ref": "#/$defs/goalRevision" },
        { "$ref": "#/$defs/criterionAssessment" }
      ]
    },
    "workspaceInitTerminalMutation": {
      "required": ["workspace", "job"],
      "properties": {
        "command": { "const": "workspace.init" },
        "result": { "$ref": "urn:podway:schema:workspace-init-result:v1" }
      }
    },
    "workspaceResetAllTerminalMutation": {
      "required": ["workspace", "job"],
      "properties": {
        "command": { "const": "workspace.reset_all" },
        "result": { "type": "object" }
      }
    },
    "procedureValidation": { "properties": { "command": { "const": "procedure.validate" }, "result": { "$ref": "urn:podway:schema:procedure-validation-result:v2" } } },
    "detachedAdmission": {
      "required": ["workspace", "job"],
      "properties": {
        "command": { "enum": ["session.start", "session.start_replace", "session.begin", "session.terminal_disposition", "session.complete", "session.skip", "session.retry", "session.block", "session.unblock", "session.cancel", "session.reset", "session.decide", "session.rework", "goal.define", "goal.revise", "goal.assess_criterion", "item.check", "item.uncheck", "item.set", "item.add", "item.remove", "item.attach", "item.clear", "item.record_many"] },
        "result": { "$ref": "urn:podway:schema:detached-admission-result:v2" }
      },
      "allOf": [
        {
          "if": { "properties": { "command": { "enum": ["session.start", "session.start_replace"] } }, "required": ["command"] },
          "then": { "properties": { "result": { "required": ["procedure_digest"] } } },
          "else": { "properties": { "result": { "not": { "required": ["procedure_digest"] } } } }
        }
      ]
    },
    "sessionStart": {
      "properties": { "command": { "enum": ["session.start", "session.start_replace"] }, "result": { "oneOf": [{ "$ref": "urn:podway:schema:session-start-result:v2" }, { "$ref": "urn:podway:schema:session-start-result:v3" }] } },
      "allOf": [
        {
          "if": { "properties": { "result": { "properties": { "dry_run": { "const": false } }, "required": ["dry_run"] } }, "required": ["result"] },
          "then": { "required": ["workspace", "job"] }
        }
      ]
    },
    "sessionStartMutation": {
      "required": ["workspace", "job"],
      "properties": {
        "command": { "enum": ["session.start", "session.start_replace"] },
        "result": { "oneOf": [
          { "allOf": [{ "$ref": "urn:podway:schema:session-start-result:v2" }, { "properties": { "dry_run": { "const": false } }, "required": ["dry_run"] }] },
          { "allOf": [{ "$ref": "urn:podway:schema:session-start-result:v3" }, { "properties": { "dry_run": { "const": false } }, "required": ["dry_run"] }] }
        ] }
      }
    },
    "sessionBegin": { "required": ["workspace", "job"], "properties": { "command": { "const": "session.begin" }, "result": { "$ref": "urn:podway:schema:session-begin-result:v1" } } },
    "terminalDisposition": { "required": ["workspace", "job"], "properties": { "command": { "const": "session.terminal_disposition" }, "result": { "$ref": "urn:podway:schema:terminal-disposition-result:v1" } } },
    "sessionReset": {
      "properties": { "command": { "const": "session.reset" }, "result": { "$ref": "urn:podway:schema:session-reset-result:v1" } },
      "allOf": [
        { "if": { "properties": { "result": { "properties": { "dry_run": { "const": false } }, "required": ["dry_run"] } }, "required": ["result"] }, "then": { "required": ["workspace", "job"] } }
      ]
    },
    "status": { "properties": { "command": { "const": "session.status" }, "result": { "oneOf": [{ "$ref": "urn:podway:schema:status-result:v2" }, { "$ref": "urn:podway:schema:status-result:v3" }] } } },
    "compactStatus": { "properties": { "command": { "const": "session.status" }, "result": { "oneOf": [{ "$ref": "urn:podway:schema:compact-status-result:v2" }, { "$ref": "urn:podway:schema:compact-status-result:v3" }] } } },
    "next": { "properties": { "command": { "const": "session.next" }, "result": { "oneOf": [{ "$ref": "urn:podway:schema:next-result:v2" }, { "$ref": "urn:podway:schema:prepared-next-result:v1" }] } } },
    "observation": { "properties": { "command": { "const": "session.observe" }, "result": { "oneOf": [{ "$ref": "urn:podway:schema:observation-result:v1" }, { "$ref": "urn:podway:schema:observation-result:v2" }] } } },
    "stageTransition": {
      "required": ["workspace"],
      "properties": { "command": { "enum": ["session.complete", "session.skip", "session.retry", "session.block", "session.unblock", "session.cancel", "session.reset"] }, "result": { "$ref": "urn:podway:schema:stage-transition-result:v2" } },
      "allOf": [
        {
          "if": { "properties": { "result": { "properties": { "admission": { "properties": { "admitted": { "const": true } }, "required": ["admitted"] } }, "required": ["admission"] } }, "required": ["result"] },
          "then": { "required": ["job"] },
          "else": { "not": { "required": ["job"] } }
        }
      ]
    },
    "itemMutation": { "required": ["workspace", "job"], "properties": { "command": { "enum": ["item.check", "item.uncheck", "item.set", "item.add", "item.remove", "item.attach", "item.clear"] }, "result": { "$ref": "urn:podway:schema:item-mutation-result:v2" } } },
    "itemRecordMany": { "required": ["workspace", "job"], "properties": { "command": { "const": "item.record_many" }, "result": { "$ref": "urn:podway:schema:item-record-many-result:v1" } } },
    "jobLookup": { "properties": { "command": { "const": "job.lookup" }, "result": { "oneOf": [{ "$ref": "urn:podway:schema:job-lookup-result:v3" }, { "$ref": "urn:podway:schema:job-lookup-result:v4" }] } } },
    "jobResult": { "required": ["job"], "properties": { "command": { "enum": ["job.status", "job.wait"] }, "result": { "oneOf": [{ "$ref": "urn:podway:schema:job-result:v3" }, { "$ref": "urn:podway:schema:job-result:v4" }] } } },
    "procedureSource": { "properties": { "command": { "enum": ["procedure.format", "procedure.scaffold"] }, "result": { "$ref": "urn:podway:schema:procedure-source-result:v1" } } },
    "procedureDiagnostics": { "properties": { "command": { "enum": ["procedure.format", "procedure.validate", "procedure.vet", "procedure.lint", "procedure.check", "procedure.graph", "procedure.scaffold"] }, "result": { "$ref": "urn:podway:schema:procedure-diagnostics-result:v1" } } },
    "procedureGraph": { "properties": { "command": { "const": "procedure.graph" }, "result": { "$ref": "urn:podway:schema:procedure-graph-result:v1" } } },
    "procedurePreview": { "properties": { "command": { "const": "procedure.preview" }, "result": { "$ref": "urn:podway:schema:procedure-preview-result:v1" } } },
    "decision": { "required": ["workspace", "job"], "properties": { "command": { "const": "session.decide" }, "result": { "$ref": "urn:podway:schema:decision-result:v1" } } },
    "rework": { "required": ["workspace", "job"], "properties": { "command": { "const": "session.rework" }, "result": { "$ref": "urn:podway:schema:rework-result:v1" } } },
    "goalDefinition": { "required": ["workspace", "job"], "properties": { "command": { "const": "goal.define" }, "result": { "$ref": "urn:podway:schema:goal-definition-result:v1" } } },
    "goalRevision": { "required": ["workspace", "job"], "properties": { "command": { "const": "goal.revise" }, "result": { "$ref": "urn:podway:schema:goal-revision-result:v1" } } },
    "criterionAssessment": { "required": ["workspace", "job"], "properties": { "command": { "const": "goal.assess_criterion" }, "result": { "$ref": "urn:podway:schema:criterion-assessment-result:v1" } } }
  }
}
