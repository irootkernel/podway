{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:output:v3",
  "title": "Podway Success Output v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "command",
    "generated_at",
    "result",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "podway.output/v3"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "command": {
      "const": "version"
    },
    "generated_at": {
      "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/timestamp"
    },
    "result": {
      "$ref": "urn:podway:schema:version-result:v1"
    },
    "warnings": {
      "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/warnings"
    }
  },
  "$comment": "Temporary version-only identity envelope retained until the V2DFC-009 identity cutover. All operational commands use output v4."
}
