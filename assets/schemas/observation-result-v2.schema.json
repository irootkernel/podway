{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:observation-result:v2",
  "title": "Podway Observation Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "guidance", "active_items", "mutation_templates"],
  "properties": {
    "schema": { "const": "podway.observation-result/v2" },
    "status": { "$ref": "urn:podway:schema:status-result:v3" },
    "guidance": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "urn:podway:schema:next-result:v2" },
        { "$ref": "urn:podway:schema:prepared-next-result:v1" }
      ]
    },
    "active_items": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/activeItem" }
    },
    "mutation_templates": {
      "type": "array",
      "maxItems": 384,
      "items": { "$ref": "#/$defs/mutationTemplate" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "properties": {
              "session": {
                "properties": { "lifecycle": { "const": "running" } },
                "required": ["lifecycle"]
              }
            },
            "required": ["session"]
          }
        },
        "required": ["status"]
      },
      "then": { "properties": { "guidance": { "$ref": "urn:podway:schema:next-result:v2" } } }
    },
    {
      "if": { "properties": { "status": { "properties": { "session": { "properties": { "lifecycle": { "const": "prepared" } }, "required": ["lifecycle"] } }, "required": ["session"] } }, "required": ["status"] },
      "then": {
        "properties": {
          "guidance": { "$ref": "urn:podway:schema:prepared-next-result:v1" },
          "active_items": { "maxItems": 0 },
          "mutation_templates": {
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              { "contains": { "properties": { "command": { "const": "session.begin" } }, "required": ["command"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "command": { "const": "session.reset" } }, "required": ["command"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "command": { "const": "session.start_replace" } }, "required": ["command"] }, "minContains": 1, "maxContains": 1 }
            ],
            "items": {
              "allOf": [
                { "$ref": "#/$defs/mutationTemplate" },
                {
                  "properties": {
                    "command": { "enum": ["session.begin", "session.reset", "session.start_replace"] },
                    "preconditions": { "properties": { "session_revision": { "const": 0 } } }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "properties": { "session": { "properties": { "lifecycle": { "enum": ["completed", "cancelled"] } }, "required": ["lifecycle"] } }, "required": ["session"] } }, "required": ["status"] },
      "then": {
        "properties": {
          "guidance": { "type": "null" },
          "active_items": { "maxItems": 0 },
          "mutation_templates": { "minItems": 1, "maxItems": 3, "items": { "allOf": [{ "$ref": "#/$defs/mutationTemplate" }, { "properties": { "command": { "enum": ["session.terminal_disposition", "session.reset", "session.start_replace"] } } }] } }
        }
      }
    }
  ],
  "$defs": {
    "activeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "type", "prompt", "required", "satisfied", "revision", "constraints", "value", "value_truncated"],
      "properties": {
        "item_id": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" },
        "type": { "enum": ["confirm", "text", "choice", "integer", "list", "artifact"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 300 },
        "help": { "type": "string", "maxLength": 1000 },
        "required": { "type": "boolean" },
        "satisfied": { "type": "boolean" },
        "revision": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/revision" },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_length": { "type": "integer", "minimum": 0, "maximum": 16384 },
            "max_length": { "type": "integer", "minimum": 0, "maximum": 16384 },
            "multiline": { "type": "boolean" },
            "choices": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
            "minimum": { "type": "integer" },
            "maximum": { "type": "integer" },
            "min_items": { "type": "integer", "minimum": 0, "maximum": 200 },
            "max_items": { "type": "integer", "minimum": 1, "maximum": 200 },
            "max_item_length": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "unique": { "type": "boolean" },
            "allowed_media_types": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255 } }
          }
        },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/itemValue" }
          ]
        },
        "value_truncated": { "type": "boolean" }
      }
    },
    "mutationTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "argv", "preconditions", "authority", "idempotency_key_required", "requires_explicit_authorization"],
      "properties": {
        "command": {
          "anyOf": [
            { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/v2Command" },
            { "$ref": "urn:podway:schema:v2-result-components:v2#/$defs/lifecycleCommand" }
          ]
        },
        "argv": { "type": "array", "minItems": 2, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } },
        "preconditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspace_uuid", "session_id", "session_revision"],
          "properties": {
            "workspace_uuid": { "type": "string", "format": "uuid" },
            "session_id": { "type": "string", "format": "uuid" },
            "session_revision": { "$ref": "urn:podway:schema:v2-result-components:v2#/$defs/sessionRevision" },
            "attempt_id": { "type": "string", "format": "uuid" },
            "item_revision": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/revision" },
            "goal_revision": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 }
          }
        },
        "authority": { "const": "optimistic_concurrency_only" },
        "idempotency_key_required": { "const": true },
        "requires_explicit_authorization": { "type": "boolean" }
      }
    }
  }
}
