{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:workspace-schema-unsupported-details:v1",
  "title": "Podway Workspace Schema Unsupported Details v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "store_schema_version",
    "supported_store_schema_version",
    "guidance"
  ],
  "properties": {
    "schema": {
      "const": "podway.workspace-schema-unsupported-details/v1"
    },
    "store_schema_version": {
      "type": "integer",
      "minimum": 15,
      "maximum": 4294967295
    },
    "supported_store_schema_version": {
      "const": 14
    },
    "guidance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
