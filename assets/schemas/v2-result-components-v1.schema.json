{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:v2-result-components:v1",
  "title": "Podway v2 Result Components v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "artifactValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_type",
        "location",
        "sha256_digest",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "location_type": {
          "enum": [
            "path",
            "reference"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256_digest": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "checkResultValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "operation_digest",
        "input_basis",
        "executor",
        "outcome",
        "summary",
        "output_digest"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/identifier"
        },
        "operation_digest": {
          "$ref": "#/$defs/digest"
        },
        "input_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "descriptor",
            "digest"
          ],
          "properties": {
            "descriptor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "output_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
