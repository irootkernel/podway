{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:next-result:v1",
  "title": "Podway Next Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage",
    "missing_required_items",
    "blockers",
    "allowed_actions",
    "next_stage_after_completion",
    "suggestions"
  ],
  "properties": {
    "schema": { "const": "podway.next-result/v1" },
    "stage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "attempt_id", "attempt_number", "instructions"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "attempt_id": { "type": "string", "format": "uuid" },
            "attempt_number": { "type": "integer", "minimum": 1 },
            "instructions": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "missing_required_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "prompt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["confirm", "text", "choice", "integer", "list", "artifact"] },
          "prompt": { "type": "string" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "attempt_id", "reason"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "attempt_id": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allowed_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "skip",
        "retry",
        "return_to",
        "cancel"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "skip": {
          "type": "boolean"
        },
        "retry": {
          "type": "boolean"
        },
        "return_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cancel": {
          "type": "boolean"
        }
      }
    },
    "next_stage_after_completion": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "argv"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "item_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
