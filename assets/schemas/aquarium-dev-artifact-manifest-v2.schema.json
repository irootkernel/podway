{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:aquarium-dev-artifact-manifest:v2",
  "title": "Aquarium development artifact manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "git_sha", "development_version", "artifact_kind", "artifact_path", "command_path", "controller_path", "sha256"],
  "properties": {
    "schema": {"const": "aquarium-dev-artifact-manifest/v2"},
    "project_id": {"const": "podway"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "development_version": {"type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-dev\\.[0-9a-f]{12}$"},
    "artifact_kind": {"const": "managed-service"},
    "artifact_path": {"const": "bundle"},
    "command_path": {"const": "bin/podway"},
    "controller_path": {"const": "libexec/aquarium-dev-service"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
