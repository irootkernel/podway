{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:workspace:v1",
  "title": "Podway Workspace Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "podway.workspace/v1"
    },
    "procedure_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "default": [
        ".podway/procedures"
      ]
    },
    "default_preset": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64,
      "default": "sw-dev-v2"
    },
    "job_queue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_pending": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 256
        }
      },
      "default": {
        "max_pending": 256
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show_stage_in_prompt": {
          "type": "boolean",
          "default": false
        }
      },
      "default": {
        "show_stage_in_prompt": false
      }
    }
  }
}
