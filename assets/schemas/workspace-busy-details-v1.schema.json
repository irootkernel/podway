{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:workspace-busy-details:v1",
  "title": "Podway Workspace Busy Details v1",
  "$comment": "Reserved by V2DFC-003; not emitted before the owning daemon-free cutover task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "boundary",
    "timeout_ms",
    "recovery"
  ],
  "properties": {
    "schema": {
      "const": "podway.workspace-busy-details/v1"
    },
    "boundary": {
      "const": "sqlite_write_lock"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600000
    },
    "recovery": {
      "$ref": "urn:podway:schema:recovery-recipe:v2",
      "properties": {
        "action": {
          "enum": [
            "refresh_state",
            "diagnose_workspace"
          ]
        },
        "command": {
          "enum": [
            "session.observe",
            "workspace.doctor"
          ]
        },
        "requires_explicit_authorization": {
          "const": false
        }
      }
    }
  }
}
