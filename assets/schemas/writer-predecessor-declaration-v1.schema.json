{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:writer-predecessor-declaration:v1",
  "title": "Podway Writer Predecessor Declaration v1",
  "$comment": "Reserved by V2DFC-003; not emitted before the owning daemon-free cutover task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "current_contract_manifest_digest",
    "predecessors"
  ],
  "properties": {
    "schema": {
      "const": "podway.writer-predecessor-declaration/v1"
    },
    "current_contract_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predecessors": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_manifest_digest",
          "store_schema_version",
          "migration_id"
        ],
        "properties": {
          "contract_manifest_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "store_schema_version": {
            "type": "integer",
            "minimum": 14,
            "maximum": 18446744073709551615
          },
          "migration_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      }
    }
  }
}
