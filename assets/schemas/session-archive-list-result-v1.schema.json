{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:session-archive-list-result:v1",
  "title": "Podway Session Archive List Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maximum", "count", "sessions"],
  "properties": {
    "schema": { "const": "podway.session-archive-list-result/v1" },
    "maximum": { "const": 32 },
    "count": { "type": "integer", "minimum": 0, "maximum": 32 },
    "sessions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/archiveSummary" } }
  },
  "$defs": {
    "archiveSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "task_title", "lifecycle", "session_revision", "archive_slot", "archived_at_ms", "archived_workspace_revision"],
      "properties": {
        "session_id": { "type": "string", "format": "uuid" },
        "task_title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "lifecycle": { "enum": ["completed", "cancelled"] },
        "session_revision": { "$ref": "urn:podway:schema:v2-result-components:v2#/$defs/runningSessionRevision" },
        "archive_slot": { "type": "integer", "minimum": 1, "maximum": 32 },
        "archived_at_ms": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "archived_workspace_revision": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 }
      }
    }
  }
}
