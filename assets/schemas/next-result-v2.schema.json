{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:next-result:v2",
  "title": "Podway Next Result v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "procedure_schema", "procedure_digest", "goal_tracking", "goal_defined", "node", "attempt", "trace_length", "counters", "queue", "revision", "readiness", "missing_required_item_count", "blockers_total", "allowed_actions", "suggestions", "references", "readback", "allowed_manual_rework_targets"],
  "properties": {
    "schema": { "const": "podway.next-result/v2" }, "procedure_schema": { "const": "podway.procedure/v2" },
    "procedure_digest": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/digest" },
    "goal_tracking": { "type": "boolean" }, "goal_defined": { "type": "boolean" }, "goal_revision": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
    "latest_goal_outcome": { "enum": ["achieved", "not_achieved", "superseded"] }, "goal": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/goalDisplay" },
    "node": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/nodeIdentity" }, "attempt": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/attemptIdentity" },
    "trace_length": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "counters": { "type": "array", "maxItems": 64, "items": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/counter" } },
    "queue": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/queue" }, "revision": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/sessionRevision" },
    "readiness": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/readiness" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "intent": { "type": "string", "minLength": 1, "maxLength": 300 },
    "description": { "type": "string", "maxLength": 1000 }, "objective": { "type": "string", "minLength": 1, "maxLength": 300 },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 500 }, "reason_policy": { "type": "object", "additionalProperties": false, "required": ["required"], "properties": { "required": { "const": true }, "prompt": { "type": "string", "minLength": 1, "maxLength": 300 } } },
    "instructions": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "missing_required_item_count": { "type": "integer", "minimum": 0, "maximum": 64 },
    "missing_required_items": { "type": "array", "maxItems": 64, "items": { "type": "object", "additionalProperties": false, "required": ["item_id", "prompt"], "properties": { "item_id": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" }, "prompt": { "type": "string", "minLength": 1, "maxLength": 300 } } } },
    "options": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["option_id", "label"], "properties": { "option_id": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" }, "label": { "type": "string", "minLength": 1, "maxLength": 120 }, "criteria": { "type": "string", "maxLength": 500 } } } },
    "evidence_guidance": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "next_graph_node_id": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" }, "terminal": { "type": "boolean" },
    "skip": { "type": "object", "additionalProperties": false, "required": ["allowed", "reason_required"], "properties": { "allowed": { "const": true }, "reason_required": { "type": "boolean" } } },
    "allowed_manual_rework_targets": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" } },
    "allowed_actions": { "type": "array", "maxItems": 19, "uniqueItems": true, "items": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/v2Command" } },
    "suggestions": { "type": "array", "maxItems": 128, "items": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/suggestion" } },
    "references": { "type": "array", "maxItems": 8, "items": { "allOf": [{ "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/referenceMetadata" }, { "properties": { "state": { "enum": ["resolved", "unresolved", "skipped"] } } }] } },
    "readback": { "type": "array", "maxItems": 8, "items": { "allOf": [{ "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/readback" }, { "properties": { "state": { "enum": ["resolved", "unresolved", "skipped"] } } }] } },
    "blockers_total": { "type": "integer", "minimum": 0, "maximum": 64 },
    "blockers": { "type": "array", "maxItems": 64, "items": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/blocker" } },
    "blockers_truncated": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "node": { "properties": { "node_type": { "const": "action" } }, "required": ["node_type"] } }, "required": ["node"] }, "then": { "required": ["title", "intent", "instructions", "missing_required_items", "blockers", "blockers_truncated"], "oneOf": [{ "required": ["next_graph_node_id"], "not": { "required": ["terminal"] } }, { "required": ["terminal"], "properties": { "terminal": { "const": true } }, "not": { "required": ["next_graph_node_id"] } }], "not": { "anyOf": [{ "required": ["objective"] }, { "required": ["options"] }, { "required": ["reason_policy"] }] } } },
    { "if": { "properties": { "node": { "properties": { "node_type": { "const": "decision" } }, "required": ["node_type"] } }, "required": ["node"] }, "then": { "required": ["title", "objective", "prompt", "options", "reason_policy", "missing_required_items", "blockers", "blockers_truncated"], "not": { "anyOf": [{ "required": ["intent"] }, { "required": ["instructions"] }, { "required": ["next_graph_node_id"] }, { "required": ["terminal"] }, { "required": ["skip"] }] } } },
    { "if": { "properties": { "goal_tracking": { "const": false } }, "required": ["goal_tracking"] }, "then": { "properties": { "goal_defined": { "const": false } }, "not": { "anyOf": [{ "required": ["goal_revision"] }, { "required": ["latest_goal_outcome"] }, { "required": ["goal"] }] } } },
    { "if": { "properties": { "goal_defined": { "const": false } }, "required": ["goal_defined"] }, "then": { "not": { "anyOf": [{ "required": ["goal_revision"] }, { "required": ["latest_goal_outcome"] }, { "required": ["goal"] }] } } },
    { "if": { "properties": { "goal_defined": { "const": true } }, "required": ["goal_defined"] }, "then": { "required": ["goal_revision", "goal"], "properties": { "goal_tracking": { "const": true } } } },
    { "if": { "properties": { "missing_required_item_count": { "const": 0 } }, "required": ["missing_required_item_count"] }, "then": { "properties": { "missing_required_items": { "maxItems": 0 } } } },
    { "if": { "properties": { "blockers_total": { "const": 0 } }, "required": ["blockers_total"] }, "then": { "properties": { "blockers": { "maxItems": 0 }, "blockers_truncated": { "const": false } } } }
  ]
}
