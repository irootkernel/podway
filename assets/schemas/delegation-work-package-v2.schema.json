{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:delegation-work-package:v2",
  "title": "Podway Scoped Delegation Work Package v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace_uuid",
    "task_title",
    "target",
    "selected_group",
    "delegation",
    "action",
    "goal",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "podway.delegation-work-package/v2"
    },
    "workspace_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "task_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "target": {
      "$ref": "urn:podway:schema:execution-group-records:v1#/$defs/scoped_attempt"
    },
    "selected_group": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      ]
    },
    "delegation": {
      "$ref": "urn:podway:schema:delegation-components:v1#/$defs/declaration"
    },
    "action": {
      "$ref": "urn:podway:schema:procedure:v2#/$defs/action_definition"
    },
    "goal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "statement",
            "criteria"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "statement"
                ],
                "properties": {
                  "id": {
                    "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector",
          "resolution",
          "source",
          "item_set_digest",
          "items"
        ],
        "properties": {
          "selector": {
            "$ref": "urn:podway:schema:procedure:v3#/$defs/evidence_reference"
          },
          "resolution": {
            "enum": [
              "resolved",
              "unresolved"
            ]
          },
          "source": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:podway:schema:execution-group-records:v1#/$defs/scoped_attempt"
              }
            ]
          },
          "item_set_digest": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:podway:schema:delegation-components:v1#/$defs/digest"
              }
            ]
          },
          "items": {
            "type": "array",
            "minItems": 0,
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item",
                "type",
                "revision",
                "value_digest",
                "size"
              ],
              "properties": {
                "item": {
                  "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
                },
                "type": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "enum": [
                        "confirm",
                        "text",
                        "choice",
                        "integer",
                        "list",
                        "artifact",
                        "check_result"
                      ]
                    }
                  ]
                },
                "revision": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    }
                  ]
                },
                "value_digest": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "urn:podway:schema:delegation-components:v1#/$defs/digest"
                    }
                  ]
                },
                "size": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "amount",
                        "unit"
                      ],
                      "properties": {
                        "amount": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 18446744073709551615
                        },
                        "unit": {
                          "enum": [
                            "unicode_scalar",
                            "list_entry",
                            "byte",
                            "value"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "x-podway-max-json-bytes": 950000
}
