{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:workspace:v2",
  "title": "Podway Workspace Configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "podway.workspace/v2"
    },
    "mode": {
      "const": "prod",
      "$comment": "Optional legacy production mode only; ignored and omitted from canonical serialization."
    },
    "procedure_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "default": [
        ".podway/procedures"
      ]
    },
    "default_preset": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64,
      "default": "sw-dev-v2"
    },
    "job_queue": {
      "$ref": "#/$defs/ignoredLegacyValue",
      "$comment": "Accepted only for legacy input compatibility; ignored and omitted from canonical serialization. Global parser byte, depth, node and canonical-number checks still apply."
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show_stage_in_prompt": {
          "type": "boolean",
          "default": false
        }
      },
      "default": {
        "show_stage_in_prompt": false
      }
    }
  },
  "$defs": {
    "ignoredLegacyValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "boolean",
            "number"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ignoredLegacyValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ignoredLegacyValue"
          }
        }
      ]
    }
  }
}
