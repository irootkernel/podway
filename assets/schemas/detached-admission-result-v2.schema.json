{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:detached-admission-result:v2",
  "title": "Podway Detached Admission Result v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "detached", "admission"],
  "properties": {
    "schema": { "const": "podway.detached-admission-result/v2" },
    "detached": { "const": true },
    "admission": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/admitted" },
    "procedure_digest": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/digest" }
  }
}
