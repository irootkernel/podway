{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:successor-cursor-mutation-result:v1",
  "title": "Podway Successor Cursor Mutation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "revision_before",
    "cursor",
    "lifecycle",
    "changed"
  ],
  "properties": {
    "schema": {
      "const": "podway.successor-cursor-mutation-result/v1"
    },
    "operation": {
      "enum": [
        "session.begin",
        "session.complete",
        "session.decide",
        "session.rework",
        "session.retry",
        "session.skip",
        "session.cancel",
        "session.block",
        "session.unblock",
        "goal.define",
        "goal.revise",
        "goal.assess_criterion",
        "goal.assess_criteria",
        "item.check",
        "item.uncheck",
        "item.set",
        "item.add",
        "item.remove",
        "item.attach",
        "item.clear",
        "item.record_many"
      ]
    },
    "revision_before": {
      "type": "integer",
      "minimum": 0
    },
    "cursor": {
      "$ref": "urn:podway:schema:observation-result:v7#/$defs/cursor"
    },
    "lifecycle": {
      "$ref": "urn:podway:schema:observation-result:v7#/$defs/lifecycle"
    },
    "changed": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "revision",
          "recorded",
          "previous_revision",
          "changed",
          "value_digest"
        ],
        "properties": {
          "item": {
            "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "recorded": {
            "type": "boolean"
          },
          "previous_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "changed": {
            "type": "boolean"
          },
          "value_digest": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/digest"
              }
            ]
          }
        }
      }
    },
    "goal": {
      "$ref": "urn:podway:schema:observation-result:v7#/$defs/goal"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "item.check",
              "item.uncheck",
              "item.set",
              "item.add",
              "item.remove",
              "item.attach",
              "item.clear",
              "item.record_many"
            ]
          }
        }
      },
      "then": {
        "required": [
          "items"
        ]
      },
      "else": {
        "not": {
          "required": [
            "items"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "item.check",
              "item.uncheck",
              "item.set",
              "item.add",
              "item.remove",
              "item.attach",
              "item.clear"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "goal.define",
              "goal.revise",
              "goal.assess_criterion",
              "goal.assess_criteria"
            ]
          }
        }
      },
      "then": {
        "required": [
          "goal"
        ]
      },
      "else": {
        "if": {
          "properties": {
            "operation": {
              "not": {
                "const": "session.begin"
              }
            }
          }
        },
        "then": {
          "not": {
            "required": [
              "goal"
            ]
          }
        }
      }
    }
  ]
}
