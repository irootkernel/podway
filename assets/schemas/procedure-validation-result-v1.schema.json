{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:procedure-validation-result:v1",
  "title": "Podway Procedure Validation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "file", "digest", "procedure", "warnings", "canonical_json"],
  "properties": {
    "schema": { "const": "podway.procedure-validation-result/v1" },
    "file": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "procedure": { "$ref": "urn:podway:schema:procedure:v1" },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "canonical_json": { "type": "string", "minLength": 2 }
  }
}
