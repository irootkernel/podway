{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:daemon-contract-mismatch-details:v2",
  "title": "Podway Daemon Contract Mismatch Details v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "expected", "actual", "admission", "recovery"],
  "properties": {
    "schema": { "const": "podway.daemon-contract-mismatch-details/v2" },
    "expected": { "$ref": "#/$defs/identity" },
    "actual": { "$ref": "#/$defs/identity" },
    "admission": { "$ref": "#/$defs/notAdmitted" },
    "recovery": { "$ref": "urn:podway:schema:recovery-recipe:v1" }
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["product", "contract_manifest_digest"],
      "properties": {
        "product": { "type": "string", "minLength": 1, "maxLength": 128 },
        "contract_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "notAdmitted": { "type": "object", "additionalProperties": false, "required": ["admitted"], "properties": { "admitted": { "const": false } } }
  }
}
