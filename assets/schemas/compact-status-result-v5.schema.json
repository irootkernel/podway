{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:compact-status-result:v5",
  "title": "Podway Compact Status Result v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "procedure",
    "session",
    "current",
    "goal_tracking",
    "goal_defined",
    "trace_length",
    "counters",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "podway.compact-status-result/v5"
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "schema": {
          "const": "podway.procedure/v2"
        },
        "id": {
          "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/digest"
        }
      }
    },
    "session": {
      "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/sessionIdentity"
    },
    "current": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/currentIdentity"
        }
      ]
    },
    "goal_tracking": {
      "type": "boolean"
    },
    "goal_defined": {
      "type": "boolean"
    },
    "goal_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "latest_goal_outcome": {
      "enum": [
        "achieved",
        "not_achieved",
        "superseded"
      ]
    },
    "trace_length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "counters": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/counter"
      }
    },
    "items": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "type",
          "required",
          "satisfied",
          "revision"
        ],
        "properties": {
          "item_id": {
            "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/identifier"
          },
          "type": {
            "enum": [
              "confirm",
              "text",
              "choice",
              "integer",
              "list",
              "artifact",
              "check_result"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "satisfied": {
            "type": "boolean"
          },
          "revision": {
            "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/revision"
          }
        }
      }
    },
    "delegation": {
      "$ref": "urn:podway:schema:delegation-components:v1#/$defs/projection"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "session": {
            "properties": {
              "lifecycle": {
                "const": "running"
              }
            },
            "required": [
              "lifecycle"
            ]
          }
        },
        "required": [
          "session"
        ]
      },
      "then": {
        "properties": {
          "current": {
            "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/currentIdentity"
          }
        }
      },
      "else": {
        "properties": {
          "current": {
            "type": "null"
          },
          "items": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "session": {
            "properties": {
              "lifecycle": {
                "const": "prepared"
              }
            },
            "required": [
              "lifecycle"
            ]
          }
        },
        "required": [
          "session"
        ]
      },
      "then": {
        "properties": {
          "goal_defined": {
            "const": false
          },
          "trace_length": {
            "const": 0
          },
          "counters": {
            "maxItems": 0
          },
          "items": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "goal_tracking": {
            "const": false
          }
        },
        "required": [
          "goal_tracking"
        ]
      },
      "then": {
        "properties": {
          "goal_defined": {
            "const": false
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "goal_revision"
              ]
            },
            {
              "required": [
                "latest_goal_outcome"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "goal_defined": {
            "const": false
          }
        },
        "required": [
          "goal_defined"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "goal_revision"
              ]
            },
            {
              "required": [
                "latest_goal_outcome"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "goal_defined": {
            "const": true
          }
        },
        "required": [
          "goal_defined"
        ]
      },
      "then": {
        "required": [
          "goal_revision"
        ],
        "properties": {
          "goal_tracking": {
            "const": true
          }
        }
      }
    }
  ],
  "$comment": "Reserved by V2DFC-003; not emitted before the owning daemon-free cutover task."
}
