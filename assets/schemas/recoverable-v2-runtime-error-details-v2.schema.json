{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:recoverable-v2-runtime-error-details:v2",
  "title": "Podway Recoverable Procedure v2 Runtime Error Details v2",
  "oneOf": [
    {
      "$ref": "#/$defs/evidenceReferenceStale"
    },
    {
      "$ref": "#/$defs/goalRevisionStale"
    },
    {
      "$ref": "#/$defs/evidencePageTokenStale"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "recovery"
      ],
      "properties": {
        "schema": {
          "const": "podway.recoverable-v2-runtime-error-details/v2"
        },
        "kind": {
          "type": "string",
          "maxLength": 65536
        },
        "recovery": {
          "$ref": "urn:podway:schema:recovery-recipe:v2",
          "properties": {
            "action": {
              "const": "refresh_state"
            },
            "command": {
              "const": "session.observe"
            },
            "requires_explicit_authorization": {
              "const": false
            }
          }
        }
      }
    },
    "identifier": {
      "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/identifier"
    },
    "attemptId": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "evidenceReferenceStale": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "required": [
            "graph_node_id",
            "source_graph_node_id",
            "expected_source_attempt_id",
            "current_source_attempt_id"
          ],
          "properties": {
            "kind": {
              "const": "EVIDENCE_REFERENCE_STALE"
            },
            "graph_node_id": {
              "$ref": "#/$defs/identifier"
            },
            "source_graph_node_id": {
              "$ref": "#/$defs/identifier"
            },
            "expected_source_attempt_id": {
              "$ref": "#/$defs/attemptId"
            },
            "current_source_attempt_id": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/attemptId"
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "goalRevisionStale": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "required": [
            "expected_goal_revision",
            "actual_goal_revision"
          ],
          "properties": {
            "kind": {
              "const": "GOAL_REVISION_STALE"
            },
            "expected_goal_revision": {
              "$ref": "#/$defs/revision"
            },
            "actual_goal_revision": {
              "$ref": "#/$defs/revision"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "evidencePageTokenStale": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "required": [
            "graph_node_id",
            "source_graph_node_id",
            "item_id",
            "expected_value_digest",
            "current_value_digest"
          ],
          "properties": {
            "kind": {
              "const": "EVIDENCE_PAGE_TOKEN_STALE"
            },
            "graph_node_id": {
              "$ref": "#/$defs/identifier"
            },
            "source_graph_node_id": {
              "$ref": "#/$defs/identifier"
            },
            "item_id": {
              "$ref": "#/$defs/identifier"
            },
            "expected_value_digest": {
              "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/digest"
            },
            "current_value_digest": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/digest"
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "$comment": "Reserved by V2DFC-003; not emitted before the owning daemon-free cutover task."
}
