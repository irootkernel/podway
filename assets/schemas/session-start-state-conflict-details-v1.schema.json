{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:session-start-state-conflict-details:v1",
  "title": "Podway Session Start State Conflict Details v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lifecycle", "current_terminal_disposition", "allowed_actions", "admission"],
  "properties": {
    "schema": { "const": "podway.session-start-state-conflict-details/v1" },
    "lifecycle": { "enum": ["prepared", "running", "completed", "cancelled"] },
    "current_terminal_disposition": { "type": "boolean" },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["continue", "preserve", "delete", "record_disposition", "start"] }
    },
    "admission": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/admission" }
  },
  "allOf": [
    { "if": { "properties": { "lifecycle": { "const": "prepared" } }, "required": ["lifecycle"] }, "then": { "properties": { "allowed_actions": { "const": ["continue", "delete"] } } } },
    { "if": { "properties": { "lifecycle": { "const": "running" } }, "required": ["lifecycle"] }, "then": { "properties": { "allowed_actions": { "const": ["continue", "preserve", "delete"] } } } },
    { "if": { "properties": { "lifecycle": { "enum": ["completed", "cancelled"] }, "current_terminal_disposition": { "const": false } }, "required": ["lifecycle", "current_terminal_disposition"] }, "then": { "properties": { "allowed_actions": { "const": ["continue", "record_disposition"] } } } },
    { "if": { "properties": { "lifecycle": { "enum": ["completed", "cancelled"] }, "current_terminal_disposition": { "const": true } }, "required": ["lifecycle", "current_terminal_disposition"] }, "then": { "properties": { "allowed_actions": { "const": ["start"] } } } }
  ]
}
