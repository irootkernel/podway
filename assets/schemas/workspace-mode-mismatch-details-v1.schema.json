{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:workspace-mode-mismatch-details:v1",
  "title": "Podway Workspace Mode Mismatch Details v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "boundary", "expected_mode", "actual_mode"],
  "properties": {
    "schema": { "const": "podway.workspace-mode-mismatch-details/v1" },
    "boundary": { "enum": ["endpoint", "daemon", "config", "store", "registry"] },
    "expected_mode": { "$ref": "#/$defs/mode" },
    "actual_mode": { "$ref": "#/$defs/mode" }
  },
  "$defs": {
    "mode": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
  }
}
