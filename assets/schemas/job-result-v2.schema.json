{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:job-result:v2",
  "title": "Podway Job Status and Wait Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job"],
  "properties": {
    "schema": { "const": "podway.job-result/v2" },
    "job": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/terminalResponse" }] }
  },
  "$defs": {
    "terminalSuccessResponse": {
      "$ref": "urn:podway:schema:output:v2#/$defs/terminalMutationOutput"
    },
    "terminalErrorResponse": {
      "x-podway-max-json-bytes": 524288,
      "allOf": [
        { "$ref": "urn:podway:schema:error:v1" },
        {
          "required": ["workspace"],
          "propertyNames": {
            "enum": ["schema", "request_id", "command", "generated_at", "code", "message", "retryable", "exit_code", "workspace", "details"]
          },
          "properties": {
            "command": { "enum": ["session.start", "session.start_replace", "session.complete", "session.skip", "session.retry", "session.block", "session.unblock", "session.cancel", "session.reset", "session.decide", "session.rework", "goal.define", "goal.revise", "goal.assess_criterion", "item.check", "item.uncheck", "item.set", "item.add", "item.remove", "item.attach", "item.clear"] },
            "message": { "type": "string", "minLength": 1, "maxLength": 512 },
            "workspace": {
              "type": "object",
              "additionalProperties": false,
              "required": ["uuid", "root", "latest_workspace_sequence"],
              "properties": {
                "uuid": { "type": "string", "format": "uuid" },
                "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "latest_workspace_sequence": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
              }
            }
          }
        }
      ]
    },
    "terminalMutationResponse": {
      "oneOf": [
        { "$ref": "#/$defs/terminalSuccessResponse" },
        { "$ref": "#/$defs/terminalErrorResponse" }
      ]
    },
    "cancelledResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "cancelled" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["cancelled"], "properties": { "cancelled": { "const": true } } }
      }
    },
    "terminalResponse": {
      "oneOf": [
        { "$ref": "#/$defs/terminalMutationResponse" },
        { "$ref": "#/$defs/cancelledResponse" }
      ]
    }
  }
}
