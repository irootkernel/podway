{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:session-archive-show-result:v2",
  "title": "Podway Session Archive Show Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "activity",
    "archive",
    "terminal_disposition",
    "state",
    "receipt_summaries",
    "receipt_summaries_total",
    "receipt_summaries_truncated"
  ],
  "properties": {
    "schema": {
      "const": "podway.session-archive-show-result/v2"
    },
    "activity": {
      "const": "inactive"
    },
    "archive": {
      "$ref": "urn:podway:schema:session-archive-list-result:v1#/$defs/archiveSummary"
    },
    "terminal_disposition": {
      "$ref": "urn:podway:schema:v2-result-components:v2#/$defs/terminalDisposition"
    },
    "state": {
      "$ref": "urn:podway:schema:status-result:v4"
    },
    "receipt_summaries": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "urn:podway:schema:delegation-components:v1#/$defs/receiptSummary"
      }
    },
    "receipt_summaries_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "receipt_summaries_truncated": {
      "type": "boolean"
    }
  }
}
