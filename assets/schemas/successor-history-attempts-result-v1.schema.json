{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:successor-history-attempts-result:v1",
  "title": "Podway Retained Attempt List Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace",
    "session",
    "session_location",
    "session_revision",
    "truncated",
    "next_page_token",
    "total",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": "podway.successor-history-attempts-result/v1"
    },
    "workspace": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "session": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "session_location": {
      "enum": [
        "current",
        "archived"
      ]
    },
    "session_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "truncated": {
      "type": "boolean"
    },
    "next_page_token": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}:[0-9a-f]{16}$"
        }
      ]
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "rows": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt",
          "lifecycle",
          "validity",
          "opened_at",
          "closed_at",
          "reason",
          "decision_entry",
          "selected_group",
          "decision",
          "delegation",
          "trace_sequence",
          "blocker_count",
          "items",
          "actor"
        ],
        "properties": {
          "attempt": {
            "$ref": "urn:podway:schema:execution-group-records:v1#/$defs/scoped_attempt"
          },
          "lifecycle": {
            "enum": [
              "active",
              "completed",
              "skipped",
              "abandoned"
            ]
          },
          "validity": {
            "enum": [
              "valid",
              "stale"
            ]
          },
          "opened_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "closed_at": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            ]
          },
          "decision_entry": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 18446744073709551615
              }
            ]
          },
          "selected_group": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            ]
          },
          "decision": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "option",
                  "reason",
                  "goal_assessment"
                ],
                "properties": {
                  "option": {
                    "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "goal_assessment": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "urn:podway:schema:successor-history-records:v1#/$defs/assessment"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "delegation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:podway:schema:execution-group-records:v1#/$defs/delegation_binding"
              }
            ]
          },
          "trace_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "blocker_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          },
          "items": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "urn:podway:schema:successor-history-records:v1#/$defs/item_stamp"
            }
          },
          "actor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              }
            ]
          }
        }
      }
    }
  }
}
