{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:procedure-preview-result:v1",
  "title": "Podway Procedure Preview Result v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "procedure_schema", "procedure_digest", "entry_graph_node_id", "node_count", "edge_count", "terminal_graph_node_ids", "goal_tracking"],
  "properties": {
    "schema": { "const": "podway.procedure-preview-result/v1" }, "procedure_schema": { "const": "podway.procedure/v2" },
    "procedure_digest": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/digest" },
    "entry_graph_node_id": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" },
    "node_count": { "type": "integer", "minimum": 1, "maximum": 64 }, "edge_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "terminal_graph_node_ids": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" } },
    "goal_tracking": { "type": "boolean" }
  }
}
