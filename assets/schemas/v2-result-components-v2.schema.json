{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:v2-result-components:v2",
  "title": "Podway Prepared-aware v2 Result Components v2",
  "$defs": {
    "sessionLifecycle": { "enum": ["prepared", "running", "completed", "cancelled"] },
    "sessionRevision": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "runningSessionRevision": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
    "sessionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lifecycle", "revision"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "lifecycle": { "$ref": "#/$defs/sessionLifecycle" },
        "revision": { "$ref": "#/$defs/sessionRevision" }
      },
      "allOf": [
        {
          "if": { "properties": { "lifecycle": { "const": "prepared" } }, "required": ["lifecycle"] },
          "then": { "properties": { "revision": { "const": 0 } } },
          "else": { "properties": { "revision": { "$ref": "#/$defs/runningSessionRevision" } } }
        }
      ]
    },
    "sessionOutput": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "lifecycle", "revision_before", "revision_after"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "lifecycle": { "$ref": "#/$defs/sessionLifecycle" },
        "revision_before": { "$ref": "#/$defs/sessionRevision" },
        "revision_after": { "$ref": "#/$defs/sessionRevision" }
      }
    },
    "terminalDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "session_revision", "recorded_at"],
      "properties": {
        "kind": { "enum": ["handed_off", "not_required"] },
        "session_revision": { "$ref": "#/$defs/runningSessionRevision" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "actor": { "type": "string", "minLength": 1, "maxLength": 256 },
        "recorded_at": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "handed_off" } }, "required": ["kind"] },
          "then": { "required": ["summary", "reference"], "not": { "required": ["reason"] } },
          "else": { "required": ["reason"], "not": { "anyOf": [{ "required": ["summary"] }, { "required": ["reference"] }] } }
        }
      ]
    },
    "resetMode": { "enum": ["eligible", "force"] },
    "resetRequiredAction": { "enum": ["none", "record_disposition", "force"] },
    "lifecycleCommand": { "enum": ["session.begin", "session.terminal_disposition", "session.reset", "session.start_replace"] },
    "lifecycleSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "argv"],
      "properties": {
        "command": { "$ref": "#/$defs/lifecycleCommand" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    }
  }
}
