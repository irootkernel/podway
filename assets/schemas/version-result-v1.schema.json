{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:version-result:v1",
  "title": "Podway Version Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product", "version", "target", "build_identity", "source_commit", "contract_manifest_schema", "contract_manifest_digest", "supported_ipc_ids"],
  "properties": {
    "schema": { "const": "podway.version-result/v1" },
    "product": { "const": "podway" },
    "version": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "build_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source_commit": { "type": ["string", "null"], "minLength": 1 },
    "contract_manifest_schema": { "const": "podway.contract-manifest/v1" },
    "contract_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "supported_ipc_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
