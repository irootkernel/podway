{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:item-record-many-result:v1",
  "title": "Podway Atomic Item Record Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "admission", "changed", "graph_node_id", "attempt_id", "attempt_number", "revision", "items"],
  "properties": {
    "schema": { "const": "podway.item-record-many-result/v1" },
    "admission": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/admitted" },
    "changed": { "type": "boolean" },
    "graph_node_id": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" },
    "attempt_id": { "type": "string", "format": "uuid" },
    "attempt_number": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
    "revision": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/sessionRevision" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "expected_item_revision", "changed", "item_revision"],
        "properties": {
          "item_id": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" },
          "expected_item_revision": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
          "changed": { "type": "boolean" },
          "item_revision": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
          "value_digest": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/digest" }
        }
      }
    }
  }
}
