{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:workspace-uuid-mismatch-details:v3",
  "title": "Podway Workspace Uuid Mismatch Details v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "expected_workspace_uuid",
    "actual_workspace_uuid",
    "recovery"
  ],
  "properties": {
    "schema": {
      "const": "podway.workspace-uuid-mismatch-details/v3"
    },
    "expected_workspace_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "actual_workspace_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "recovery": {
      "$ref": "urn:podway:schema:recovery-recipe:v2",
      "properties": {
        "action": {
          "const": "diagnose_workspace"
        },
        "command": {
          "const": "workspace.doctor"
        },
        "requires_explicit_authorization": {
          "const": false
        }
      }
    }
  }
}
