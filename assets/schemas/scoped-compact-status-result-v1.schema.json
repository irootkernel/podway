{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:scoped-compact-status-result:v1",
  "title": "Podway Scoped Compact Status Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace",
    "workspace_sequence",
    "lifecycle",
    "cursor",
    "base",
    "items",
    "retained_group_count",
    "trace_length"
