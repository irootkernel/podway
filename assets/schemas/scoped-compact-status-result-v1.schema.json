      "const": "podway.scoped-compact-status-result/v1"
    },
    "workspace": {
      "$ref": "urn:podway:schema:observation-result:v7#/properties/workspace"
    },
    "workspace_sequence": {
      "$ref": "urn:podway:schema:observation-result:v7#/properties/workspace_sequence"
    },
    "lifecycle": {
      "$ref": "urn:podway:schema:observation-result:v7#/properties/lifecycle"
    },
    "cursor": {
      "$ref": "urn:podway:schema:observation-result:v7#/properties/cursor"
    },
    "base": {
      "$ref": "urn:podway:schema:observation-result:v7#/properties/base"
    },
    "items": {
      "$ref": "urn:podway:schema:observation-result:v7#/properties/items"
    },
    "retained_group_count": {
      "$ref": "urn:podway:schema:observation-result:v7#/properties/retained_group_count"
    },
    "trace_length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    }
  }
}
