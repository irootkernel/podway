{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:session-start-state-conflict-details:v2",
  "title": "Podway Session Start State Conflict Details v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lifecycle",
    "current_terminal_disposition",
    "allowed_actions"
  ],
  "properties": {
    "schema": {
      "const": "podway.session-start-state-conflict-details/v2"
    },
    "lifecycle": {
      "enum": [
        "prepared",
        "running",
        "completed",
        "cancelled"
      ]
    },
    "current_terminal_disposition": {
      "type": "boolean"
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "continue",
          "preserve",
          "delete",
          "record_disposition",
          "start"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "prepared"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "allowed_actions": {
            "const": [
              "continue",
              "delete"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "running"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "allowed_actions": {
            "const": [
              "continue",
              "preserve",
              "delete"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "enum": [
              "completed",
              "cancelled"
            ]
          },
          "current_terminal_disposition": {
            "const": false
          }
        },
        "required": [
          "lifecycle",
          "current_terminal_disposition"
        ]
      },
      "then": {
        "properties": {
          "allowed_actions": {
            "const": [
              "continue",
              "record_disposition"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "enum": [
              "completed",
              "cancelled"
            ]
          },
          "current_terminal_disposition": {
            "const": true
          }
        },
        "required": [
          "lifecycle",
          "current_terminal_disposition"
        ]
      },
      "then": {
        "properties": {
          "allowed_actions": {
            "const": [
              "start"
            ]
          }
        }
      }
    }
  ],
  "$comment": "Current direct contract under ADR-0038; originally reserved by V2DFC-003."
}
