{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:successor-preset-result:v1",
  "title": "Podway Successor Preset Result v1",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "podway.successor-preset-result/v1"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "operation",
        "presets"
      ],
      "properties": {
        "operation": {
          "const": "preset.list"
        },
        "presets": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/metadata"
          }
        }
      }
    },
    {
      "required": [
        "operation",
        "preset",
        "base_digest",
        "group_digest",
        "procedure",
        "default_group"
      ],
      "properties": {
        "operation": {
          "const": "preset.show"
        },
        "preset": {
          "$ref": "#/$defs/metadata"
        },
        "base_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "group_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "procedure": {
          "$ref": "urn:podway:schema:procedure:v3"
        },
        "default_group": {
          "$ref": "urn:podway:schema:execution-group:v1"
        }
      }
    },
    {
      "required": [
        "operation",
        "preset",
        "base_digest",
        "group_digest",
        "goal_tracking",
        "base_graph",
        "default_group_graph"
      ],
      "properties": {
        "operation": {
          "const": "preset.explain"
        },
        "preset": {
          "$ref": "#/$defs/metadata"
        },
        "base_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "group_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "goal_tracking": {
          "type": "boolean"
        },
        "base_graph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "default_group_graph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      }
    }
  ]
}
