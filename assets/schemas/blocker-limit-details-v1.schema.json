{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:blocker-limit-details:v1",
  "title": "Podway Open Blocker Limit Details v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "maximum_open_blockers"],
      "properties": {
        "schema": { "const": "podway.blocker-limit-details/v1" },
        "maximum_open_blockers": { "enum": [64, 1024] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "maximum_open_blockers", "admission"],
      "properties": {
        "schema": { "const": "podway.blocker-limit-details/v1" },
        "maximum_open_blockers": { "enum": [64, 1024] },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["admitted"],
          "properties": { "admitted": { "const": false } }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "maximum_open_blockers", "job_id", "job_sequence", "admission"
      ],
      "properties": {
        "schema": { "const": "podway.blocker-limit-details/v1" },
        "maximum_open_blockers": { "enum": [64, 1024] },
        "job_id": { "type": "string", "format": "uuid" },
        "job_sequence": { "type": "integer", "minimum": 1 },
        "admission": { "$ref": "urn:podway:schema:output:v1#/$defs/admitted" }
      }
    }
  ]
}
