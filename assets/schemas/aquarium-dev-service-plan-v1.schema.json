{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:aquarium-dev-service-plan:v1",
  "title": "Aquarium development service plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "target_git_sha", "action", "active_git_sha", "busy", "plan_token"],
  "properties": {
    "schema": {"const": "aquarium-dev-service-plan/v1"},
    "project_id": {"const": "podway"},
    "target_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "action": {"enum": ["install", "activate", "repair", "defer", "no-change"]},
    "active_git_sha": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "busy": {"type": "boolean"},
    "plan_token": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "defer"}}, "required": ["action"]},
      "then": {"properties": {"busy": {"const": true}, "plan_token": {"type": "null"}}},
      "else": {"properties": {"busy": {"const": false}, "plan_token": {"type": "string"}}}
    }
  ]
}
