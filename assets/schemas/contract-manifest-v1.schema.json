{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:contract-manifest:v1",
  "title": "Podway Contract Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "product_version", "supported_ipc_ids", "assets", "digest"],
  "properties": {
    "schema_version": { "const": "podway.contract-manifest/v1" },
    "product": { "const": "podway" },
    "product_version": { "type": "string", "minLength": 1 },
    "supported_ipc_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {
            "enum": ["schema", "catalog", "transition_matrix", "canonicalization_rules", "known_answer_fixture", "preset"]
          },
          "path": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$" },
          "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
