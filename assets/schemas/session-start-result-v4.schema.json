{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:session-start-result:v4",
  "title": "Podway Prepared Session Start Result v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "procedure_schema",
    "procedure_digest",
    "dry_run",
    "session_state",
    "goal_tracking",
    "goal_defined",
    "active_attempt",
    "goal_revision"
  ],
  "properties": {
    "schema": {
      "const": "podway.session-start-result/v4"
    },
    "procedure_schema": {
      "const": "podway.procedure/v2"
    },
    "procedure_digest": {
      "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/digest"
    },
    "dry_run": {
      "type": "boolean"
    },
    "session_state": {
      "const": "prepared"
    },
    "goal_tracking": {
      "type": "boolean"
    },
    "goal_defined": {
      "const": false
    },
    "active_attempt": {
      "type": "null"
    },
    "goal_revision": {
      "type": "null"
    },
    "entry_graph_node_id": {
      "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/identifier"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "const": 0
    },
    "existing_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "session_revision",
        "lifecycle",
        "action"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_revision": {
          "$ref": "urn:podway:schema:v2-result-components:v4#/$defs/sessionRevision"
        },
        "lifecycle": {
          "enum": [
            "prepared",
            "running",
            "completed",
            "cancelled"
          ]
        },
        "action": {
          "enum": [
            "delete",
            "archive",
            "supersede_archive",
            "dispose_archive"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dry_run": {
            "const": true
          }
        },
        "required": [
          "dry_run"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "session_id"
              ]
            },
            {
              "required": [
                "revision"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "session_id",
          "revision"
        ]
      }
    }
  ],
  "$comment": "Reserved by V2DFC-003; not emitted before the owning daemon-free cutover task."
}
