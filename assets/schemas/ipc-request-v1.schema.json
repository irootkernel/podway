{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:ipc-request:v1",
  "title": "Podway IPC Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "client",
    "operation",
    "command",
    "options",
    "payload"
  ],
  "properties": {
    "protocol": {
      "const": "podway.ipc/v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "pid",
        "product",
        "contract_manifest_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "contract_manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "operation": {
      "enum": [
        "query",
        "mutate",
        "control",
        "bootstrap"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expected_uuid": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_revision": {
          "type": "integer",
          "minimum": 0
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "item_revision": {
          "type": "integer",
          "minimum": 0
        },
        "blocker_id": {
          "type": "string",
          "format": "uuid"
        },
        "job_state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        }
      },
      "default": {}
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detach",
        "wait_timeout_ms"
      ],
      "properties": {
        "detach": {
          "type": "boolean"
        },
        "wait_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "mutate",
              "bootstrap"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "workspace",
          "idempotency_key"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "query"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "not": {
          "required": [
            "idempotency_key"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {"const": "session.status"},
          "payload": {
            "type": "object",
            "properties": {"compact": {"const": true}},
            "required": ["compact"]
          }
        },
        "required": ["command", "payload"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["wait_for_idle"],
            "properties": {
              "wait_for_idle": {"const": true},
              "verbose": {"const": false}
            },
            "not": {"required": ["after_job_id"]}
          }
        }
      }
    }
  ]
}
