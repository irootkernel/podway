{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:session-start-result:v2",
  "title": "Podway Session Start Result v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "procedure_schema", "procedure_digest", "dry_run", "goal_tracking"],
  "properties": {
    "schema": { "const": "podway.session-start-result/v2" },
    "procedure_schema": { "const": "podway.procedure/v2" },
    "procedure_digest": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/digest" },
    "dry_run": { "type": "boolean" },
    "goal_tracking": { "type": "boolean" },
    "session_id": { "type": "string", "format": "uuid" },
    "revision": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/revision" },
    "entry_graph_node_id": { "$ref": "urn:podway:schema:v2-result-components:v1#/$defs/identifier" },
    "goal_required": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "dry_run": { "const": true } }, "required": ["dry_run"] }, "then": { "not": { "anyOf": [{ "required": ["session_id"] }, { "required": ["revision"] }, { "required": ["entry_graph_node_id"] }] } }, "else": { "required": ["session_id", "revision", "entry_graph_node_id"] } },
    { "if": { "properties": { "goal_tracking": { "const": true } }, "required": ["goal_tracking"] }, "then": { "required": ["goal_required"] }, "else": { "not": { "required": ["goal_required"] } } }
  ]
}
