{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:runtime-reset-control-input:v1",
  "title": "Podway Runtime Reset Control Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action",
    "mode",
    "namespace_root",
    "expected_process_id",
    "operation_id",
    "token_sha256",
    "reservation_id"
  ],
  "properties": {
    "schema": {
      "const": "podway.runtime-reset-control-input/v1"
    },
    "action": {
      "enum": [
        "inspect",
        "reserve",
        "snapshot",
        "release",
        "shutdown"
      ]
    },
    "mode": {
      "$ref": "urn:podway:schema:runtime-reset-components:v1#/$defs/mode"
    },
    "namespace_root": {
      "$ref": "urn:podway:schema:runtime-reset-components:v1#/$defs/path"
    },
    "expected_process_id": {
      "$ref": "urn:podway:schema:runtime-reset-components:v1#/$defs/uuid"
    },
    "operation_id": {
      "oneOf": [
        {
          "$ref": "urn:podway:schema:runtime-reset-components:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "token_sha256": {
      "oneOf": [
        {
          "$ref": "urn:podway:schema:runtime-reset-components:v1#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "reservation_id": {
      "oneOf": [
        {
          "$ref": "urn:podway:schema:runtime-reset-components:v1#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "inspect"
          }
        }
      },
      "then": {
        "properties": {
          "operation_id": {
            "type": "null"
          },
          "token_sha256": {
            "type": "null"
          },
          "reservation_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "operation_id": {
            "$ref": "urn:podway:schema:runtime-reset-components:v1#/$defs/uuid"
          },
          "token_sha256": {
            "$ref": "urn:podway:schema:runtime-reset-components:v1#/$defs/digest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "snapshot",
              "release",
              "shutdown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reservation_id": {
            "$ref": "urn:podway:schema:runtime-reset-components:v1#/$defs/uuid"
          }
        }
      },
      "else": {
        "properties": {
          "reservation_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
