{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:observation-result:v7",
  "title": "Podway Scoped Observation Result v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace",
    "workspace_sequence",
    "title",
    "base",
    "cursor",
    "lifecycle",
    "lifecycle_guidance",
    "decision_entry",
    "next_decision_entry",
    "selection",
    "counters",
    "guidance",
    "goal",
    "plan",
    "items",
    "open_blockers",
    "delegation",
    "retained_group_count",
    "remaining_activations",
    "remaining_attempts"
  ],
  "properties": {
    "schema": {
      "const": "podway.observation-result/v7"
    },
    "workspace": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "workspace_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "base": {
      "$ref": "#/$defs/base"
    },
    "cursor": {
      "$ref": "#/$defs/cursor"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "lifecycle_guidance": {
      "$ref": "#/$defs/lifecycleGuidance"
    },
    "decision_entry": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "next_decision_entry": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/selection"
        },
        {
          "type": "null"
        }
      ]
    },
    "counters": {
      "$ref": "#/$defs/counters"
    },
    "guidance": {
      "anyOf": [
        {
          "$ref": "#/$defs/guidance"
        },
        {
          "type": "null"
        }
      ]
    },
    "goal": {
      "anyOf": [
        {
          "$ref": "#/$defs/goal"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "urn:podway:schema:execution-group-records:v1#/$defs/plan"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "anyOf": [
        {
          "$ref": "#/$defs/items"
        },
        {
          "type": "null"
        }
      ]
    },
    "open_blockers": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "maxItems": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "delegation": {
      "anyOf": [
        {
          "$ref": "urn:podway:schema:execution-group-records:v1#/$defs/delegation_binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "retained_group_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "remaining_activations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "remaining_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    }
  },
  "$defs": {
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "session_revision",
        "attempt",
        "goal_revision",
        "selected_group"
      ],
      "properties": {
        "session": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "session_revision": {
          "type": "integer",
          "minimum": 0
        },
        "attempt": {
          "anyOf": [
            {
              "$ref": "urn:podway:schema:execution-group-records:v1#/$defs/scoped_attempt"
            },
            {
              "type": "null"
            }
          ]
        },
        "goal_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_group": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "revision",
          "recorded"
        ],
        "properties": {
          "item": {
            "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "recorded": {
            "type": "boolean"
          }
        }
      },
      "maxItems": 128
    },
    "counters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "node",
          "attempt_count",
          "decision_entry"
        ],
        "properties": {
          "scope": {
            "enum": [
              "base",
              "group"
            ]
          },
          "node": {
            "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          },
          "decision_entry": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "maxItems": 2048
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement",
        "definition",
        "ready",
        "items",
        "evidence",
        "available_operations",
        "manual_rework_targets"
      ],
      "properties": {
        "placement": {
          "$ref": "urn:podway:schema:procedure:v3#/$defs/graph_node"
        },
        "definition": {
          "$ref": "urn:podway:schema:procedure:v3#/$defs/node_definition"
        },
        "ready": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "required",
              "satisfied"
            ],
            "properties": {
              "item": {
                "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
              },
              "required": {
                "type": "boolean"
              },
              "satisfied": {
                "type": "boolean"
              }
            }
          },
          "maxItems": 128
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "declaration",
              "attempt"
            ],
            "properties": {
              "declaration": {
                "$ref": "urn:podway:schema:procedure:v3#/$defs/evidence_reference"
              },
              "attempt": {
                "anyOf": [
                  {
                    "$ref": "urn:podway:schema:execution-group-records:v1#/$defs/scoped_attempt"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 8
        },
        "available_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "manual_rework_targets": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
          }
        },
        "allowed_option_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
          }
        },
        "replan_option_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
          }
        },
        "option_guard_statuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option_id",
              "state",
              "predicates"
            ],
            "properties": {
              "option_id": {
                "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
              },
              "state": {
                "enum": [
                  "met",
                  "unmet",
                  "unevaluable"
                ]
              },
              "predicates": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "item",
                    "state"
                  ],
                  "properties": {
                    "source": {
                      "anyOf": [
                        {
                          "$ref": "urn:podway:schema:execution-group-records:v1#/$defs/scoped_attempt"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "item": {
                      "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
                    },
                    "state": {
                      "enum": [
                        "met",
                        "unmet",
                        "unevaluable"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "definition": {
                "properties": {
                  "type": {
                    "const": "decision"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "allowed_option_ids",
              "replan_option_ids"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "option_guard_statuses"
                  ]
                },
                {
                  "required": [
                    "allowed_option_ids"
                  ]
                },
                {
                  "required": [
                    "replan_option_ids"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "definition": {
                "required": [
                  "options"
                ],
                "properties": {
                  "options": {
                    "contains": {
                      "required": [
                        "guards"
                      ]
                    }
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "option_guard_statuses"
            ]
          },
          "else": {
            "not": {
              "required": [
                "option_guard_statuses"
              ]
            }
          }
        }
      ]
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "revision",
        "criteria",
        "outcome",
        "actor"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "status"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "status": {
                "anyOf": [
                  {
                    "enum": [
                      "satisfied",
                      "unsatisfied",
                      "not_applicable"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "id": {
                "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
              }
            }
          },
          "maxItems": 16,
          "minItems": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "achieved",
                "not_achieved",
                "superseded"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            }
          ]
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "definition_digest",
        "outcome",
        "terminal_attempt"
      ],
      "properties": {
        "execution": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "definition_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "outcome": {
          "$ref": "urn:podway:schema:execution-group-records:v1#/$defs/outcome"
        },
        "terminal_attempt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest",
        "goal_tracking"
      ],
      "properties": {
        "id": {
          "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "goal_tracking": {
          "type": "boolean"
        }
      }
    },
    "lifecycle": {
      "enum": [
        "prepared",
        "running",
        "completed",
        "cancelled"
      ]
    },
    "lifecycleGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity",
        "current_terminal_disposition",
        "operations"
      ],
      "properties": {
        "activity": {
          "enum": [
            "current",
            "archived"
          ]
        },
        "current_terminal_disposition": {
          "type": "boolean"
        },
        "operations": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "requires_explicit_authorization"
            ],
            "properties": {
              "command": {
                "enum": [
                  "session.begin",
                  "session.reset",
                  "session.start_replace",
                  "session.terminal_disposition",
                  "session.archive",
                  "session.start"
                ]
              },
              "requires_explicit_authorization": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
