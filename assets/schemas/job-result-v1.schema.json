{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:job-result:v1",
  "title": "Podway Job Status and Wait Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job"],
  "properties": {
    "schema": { "const": "podway.job-result/v1" },
    "job": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/terminalResponse" }] }
  },
  "$defs": {
    "terminalResponse": {
      "oneOf": [
        { "$ref": "urn:podway:schema:output:v1" },
        { "$ref": "urn:podway:schema:error:v1" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "payload"],
          "properties": {
            "kind": { "const": "cancelled" },
            "payload": { "type": "object", "additionalProperties": false, "required": ["cancelled"], "properties": { "cancelled": { "const": true } } }
          }
        }
      ]
    }
  }
}
