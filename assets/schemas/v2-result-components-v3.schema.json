{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:v2-result-components:v3",
  "title": "Podway V2 Result Components v3",
  "$defs": {
    "sizeUnit": {
      "enum": [
        "scalars",
        "entries",
        "value",
        "bytes"
      ]
    },
    "logicalSize": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "logicalOffset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "pageToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "pageTokenVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    }
  }
}
