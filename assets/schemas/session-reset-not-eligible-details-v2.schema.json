{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:session-reset-not-eligible-details:v2",
  "title": "Podway Session Reset Not Eligible Details v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lifecycle",
    "current_terminal_disposition",
    "required_action"
  ],
  "properties": {
    "schema": {
      "const": "podway.session-reset-not-eligible-details/v2"
    },
    "lifecycle": {
      "enum": [
        "running",
        "completed",
        "cancelled"
      ]
    },
    "current_terminal_disposition": {
      "const": false
    },
    "required_action": {
      "enum": [
        "record_disposition",
        "force"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "running"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "required_action": {
            "const": "force"
          }
        }
      },
      "else": {
        "properties": {
          "required_action": {
            "const": "record_disposition"
          }
        }
      }
    }
  ],
  "$comment": "Reserved by V2DFC-003; not emitted before the owning daemon-free cutover task."
}
