{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:version-result:v2",
  "title": "Podway Version Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "version",
    "target",
    "build_identity",
    "source_commit",
    "contract_manifest_schema",
    "contract_manifest_digest"
  ],
  "properties": {
    "schema": {
      "const": "podway.version-result/v2"
    },
    "product": {
      "const": "podway"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "build_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_commit": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "contract_manifest_schema": {
      "const": "podway.contract-manifest/v2"
    },
    "contract_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$comment": "Active direct CLI identity contract; emitted and verified by the single-binary tooling."
}
