{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:session-start-result:v1",
  "title": "Podway Session Start Result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "changed", "revision_before", "revision_after", "procedure_digest", "admission"],
      "properties": {
        "schema": { "const": "podway.session-start-result/v1" },
        "changed": { "type": "boolean" },
        "revision_before": { "type": "integer", "minimum": 0 },
        "revision_after": { "type": "integer", "minimum": 1 },
        "procedure_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "admission": { "$ref": "urn:podway:schema:output:v1#/$defs/admitted" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "dry_run", "task", "source", "procedure_digest", "first_stage"],
      "properties": {
        "schema": { "const": "podway.session-start-result/v1" },
        "dry_run": { "const": true },
        "task": { "type": "string", "minLength": 1 },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["preset"],
              "properties": { "preset": { "type": "string", "minLength": 1 } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["procedure"],
              "properties": { "procedure": { "type": "string", "minLength": 1 } }
            }
          ]
        },
        "procedure_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "first_stage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title"],
          "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 } }
        }
      }
    }
  ]
}
