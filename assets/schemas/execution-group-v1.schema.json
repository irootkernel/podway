{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:execution-group:v1",
  "title": "Podway Execution Group v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "name",
    "purpose",
    "node_definitions",
    "graph",
    "plan_inputs"
  ],
  "properties": {
    "schema": {
      "const": "podway.execution-group/v1"
    },
    "id": {
      "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
    },
    "version": {
      "$ref": "urn:podway:schema:procedure:v2#/$defs/version"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "node_definitions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1024,
      "propertyNames": {
        "$ref": "urn:podway:schema:procedure:v2#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "urn:podway:schema:procedure:v3#/$defs/node_definition"
      }
    },
    "graph": {
      "$ref": "urn:podway:schema:procedure:v3#/$defs/graph"
    },
    "manual_rework": {
      "$ref": "urn:podway:schema:procedure:v2#/$defs/manual_rework"
    },
    "plan_inputs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "urn:podway:schema:procedure:v2#/$defs/item"
      }
    }
  }
}
