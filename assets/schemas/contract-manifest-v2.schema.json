{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:contract-manifest:v2",
  "title": "Podway Contract Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "product_version",
    "assets",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "podway.contract-manifest/v2"
    },
    "product": {
      "const": "podway"
    },
    "product_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "schema",
              "catalog",
              "transition_matrix",
              "canonicalization_rules",
              "known_answer_fixture",
              "preset",
              "store_schema"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "maxItems": 4096
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$comment": "Active direct CLI identity contract; emitted and verified by the single-binary tooling."
}
