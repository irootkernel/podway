{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:workspace-maintenance-details:v1",
  "title": "Podway Workspace Maintenance Details v1",
  "$comment": "Current direct contract under ADR-0038; originally reserved by V2DFC-003.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "boundary",
    "timeout_ms",
    "recovery"
  ],
  "properties": {
    "schema": {
      "const": "podway.workspace-maintenance-details/v1"
    },
    "boundary": {
      "enum": [
        "maintenance_lock",
        "intent_marker",
        "reset_marker",
        "removal_marker",
        "predecessor_migration"
      ]
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600000
    },
    "recovery": {
      "$ref": "urn:podway:schema:recovery-recipe:v2"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "boundary": {
            "enum": [
              "maintenance_lock",
              "intent_marker",
              "predecessor_migration"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "recovery": {
            "properties": {
              "action": {
                "enum": [
                  "refresh_state",
                  "diagnose_workspace"
                ]
              },
              "command": {
                "enum": [
                  "session.observe",
                  "workspace.doctor"
                ]
              },
              "requires_explicit_authorization": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "boundary": {
            "const": "reset_marker"
          }
        }
      },
      "then": {
        "properties": {
          "recovery": {
            "properties": {
              "action": {
                "const": "resume_maintenance"
              },
              "command": {
                "const": "workspace.reset_all"
              },
              "requires_explicit_authorization": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "boundary": {
            "const": "removal_marker"
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "recovery": {
                "properties": {
                  "action": {
                    "const": "resume_maintenance"
                  },
                  "command": {
                    "const": "workspace.remove"
                  },
                  "requires_explicit_authorization": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "properties": {
              "recovery": {
                "properties": {
                  "action": {
                    "const": "diagnose_workspace"
                  },
                  "command": {
                    "const": "workspace.doctor"
                  },
                  "requires_explicit_authorization": {
                    "const": false
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
