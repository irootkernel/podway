{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:socket-endpoint-error-details:v1",
  "title": "Podway Socket Endpoint Error Details v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reason"],
  "properties": {
    "schema": { "const": "podway.socket-endpoint-error-details/v1" },
    "reason": {
      "enum": [
        "empty",
        "relative",
        "unnormalized",
        "workspace_local",
        "path_too_long",
        "effective_user_unavailable"
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted"],
      "properties": { "admitted": { "const": false } }
    }
  }
}
