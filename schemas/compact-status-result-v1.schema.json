{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:compact-status-result:v1",
  "title": "Podway Compact Status Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "procedure", "session", "current", "items", "blockers", "queue"],
  "properties": {
    "schema": {"const": "podway.compact-status-result/v1"},
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lifecycle", "revision"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "lifecycle": {"enum": ["running", "completed", "cancelled"]},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "current": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage_id", "attempt_id", "attempt_number", "ready_to_complete"],
          "properties": {
            "stage_id": {"type": "string", "minLength": 1},
            "attempt_id": {"type": "string", "format": "uuid"},
            "attempt_number": {"type": "integer", "minimum": 1},
            "ready_to_complete": {"type": "boolean"}
          }
        }
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "required", "satisfied", "revision"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["confirm", "text", "choice", "integer", "list", "artifact"]},
          "required": {"type": "boolean"},
          "satisfied": {"type": "boolean"},
          "revision": {"type": "integer", "minimum": 0}
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "attempt_id", "state"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "attempt_id": {"type": "string", "format": "uuid"},
          "state": {"const": "open"}
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending_mutations", "queued_count", "running_job_id", "latest_workspace_sequence"],
      "properties": {
        "pending_mutations": {"const": false},
        "queued_count": {"const": 0},
        "running_job_id": {"type": "null"},
        "latest_workspace_sequence": {"type": "integer", "minimum": 1}
      }
    }
  }
}
