{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:daemon-contract-mismatch-details:v1",
  "title": "Podway Daemon Contract Mismatch Details v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected", "actual", "admission"],
  "properties": {
    "expected": { "$ref": "#/$defs/identity" },
    "actual": { "$ref": "#/$defs/identity" },
    "admission": { "$ref": "#/$defs/notAdmitted" }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "contract_manifest_digest"],
      "properties": {
        "product": { "type": "string", "minLength": 1, "maxLength": 128 },
        "contract_manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "notAdmitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted"],
      "properties": { "admitted": { "const": false } }
    }
  }
}
