{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:podway:schema:job-lookup-result:v1",
  "title": "Podway Job Lookup Result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["found"],
      "properties": { "found": { "const": false } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["found", "job"],
      "properties": {
        "found": { "const": true },
        "job": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sequence", "state", "submitted_at", "finished_at", "command", "request_digest", "terminal_response"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "sequence": { "type": "integer", "minimum": 1 },
            "state": { "enum": ["queued", "running", "succeeded", "failed", "cancelled"] },
            "submitted_at": { "type": "string", "format": "date-time" },
            "claimed_at": { "type": ["string", "null"], "format": "date-time" },
            "finished_at": { "type": ["string", "null"], "format": "date-time" },
            "command": { "type": "string", "minLength": 1 },
            "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "terminal_response": { "oneOf": [{ "type": "null" }, { "$ref": "urn:podway:schema:job-result:v1#/$defs/terminalResponse" }] }
          }
        }
      }
    }
  ]
}
