{
  "schema": "podway.g009.release-policy/v1",
  "version": 1,
  "trust_anchors": {
    "repository": {
      "github_context": "github.repository",
      "allow_dispatch_repository_override": false
    },
    "controller": {
      "github_context": "github.workflow_sha",
      "require_full_commit_sha": true
    },
    "candidate_provenance": {
      "required_fields": [
        "source.commit",
        "source.tree"
      ],
      "commit_format": "40-lowercase-hex",
      "tree_format": "40-lowercase-hex",
      "require_exact_match": true
    },
    "reviewer_keyring": {
      "source": "GitHub Environment release-final-review secret G009_REVIEWER_KEYRING_B64",
      "materialized_path_argument": "--reviewer-keyring",
      "require_sha256_argument": "--reviewer-keyring-sha256",
      "sha256_format": "64-lowercase-hex",
      "repository_controlled": true,
      "fail_closed_when_unavailable": true
    },
    "reviewer_fingerprints": {
      "source": "GitHub Environment release-final-review secrets G009_OWNER_FINGERPRINT, G009_E_FINGERPRINT, G009_F_FINGERPRINT",
      "roles": [
        "owner",
        "E",
        "F"
      ],
      "format": "40-uppercase-hex",
      "require_exact_validsig_primary_fingerprint": true,
      "require_distinct": true,
      "fail_closed_when_unavailable": true
    }
  },
  "tool_policy": {
    "identity_requirement": "version-sha256-and-arm64-execution",
    "required_tools": [
      {
        "id": "bash"
      },
      {
        "id": "cargo",
        "version": "1.85.0"
      },
      {
        "id": "cargo-audit"
      },
      {
        "id": "cargo-deny"
      },
      {
        "id": "cargo-fuzz"
      },
      {
        "id": "cargo-llvm-cov"
      },
      {
        "id": "cargo-nightly",
        "version": "nightly-2026-07-17"
      },
      {
        "id": "git"
      },
      {
        "id": "gpgv"
      },
      {
        "id": "launchctl"
      },
      {
        "id": "lipo"
      },
      {
        "id": "ps"
      },
      {
        "id": "python3"
      },
      {
        "id": "rustc",
        "version": "1.85.0"
      },
      {
        "id": "rustc-nightly",
        "version": "nightly-2026-07-17"
      },
      {
        "id": "rustup"
      },
      {
        "id": "sandbox-exec"
      },
      {
        "id": "sysctl"
      }
    ],
    "require_exact_tool_set": true
  },
  "stage_contract": {
    "stage_1": {
      "name": "trusted-controller-qualification",
      "candidate_is_separate": true,
      "outputs": [
        "immutable-acceptance-index",
        "immutable-archive-bundle"
      ]
    },
    "stage_2": {
      "name": "independent-final-review",
      "requires_stage_1_index": true,
      "requires_independently_anchored_owner_E_F_signatures": true,
      "outputs": [
        "final-bundle"
      ]
    }
  },
  "rc_transport": {
    "trusted_upstream_artifact": true,
    "immutable_locator": {
      "scheme": "sha256",
      "format": "sha256:<64-lowercase-hex-digits>",
      "argument": "--rc",
      "trusted_upstream_artifact_required": true
    },
    "forbid": [
      "local-path",
      "file-uri",
      "relative-path",
      "branch",
      "tag",
      "latest",
      "mutable-url"
    ],
    "required_rc_schema": "podway.g009.rc-intent/v1",
    "consumer_verification": {
      "before_each_gate": true,
      "required_bindings": [
        "rc_sha256",
        "source.commit",
        "source.tree",
        "target",
        "host",
        "inputs",
        "binaries",
        "signing"
      ],
      "verify_input_sha256": true,
      "verify_binary_sha256": true,
      "verify_detached_signature": true,
      "reject_on_identity_or_signature_failure": true
    }
  },
  "native_platform": {
    "system": "Darwin",
    "host_arch": "arm64",
    "target": "aarch64-apple-darwin",
    "mach_o_arch": "arm64",
    "require_native_execution": true,
    "forbid": [
      "x86_64",
      "Rosetta",
      "translated-process",
      "universal-binary",
      "fat-binary"
    ]
  },
