        "run_generation": {
          "type": "integer",
          "minimum": 1
        },
        "effective_policy": {
          "$ref": "#/$defs/caller_policy_proof/properties/effective_policy"
        }
      },
      "x-invariants": [
        "Receipt is created only after positively verified reader startup or the matching Writer commit",
        "Original policy access agrees with immutable requested_access; later mutable policy does not rewrite this receipt",
        "Receipt binds the original accepted-intent digest, Run, Thread, generation and Profile binding",
        "Missing or corrupt receipt is never reconstructed from current Role files or a replacement Run"
      ]
    },
    "caller_native_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation_id",
        "method"
