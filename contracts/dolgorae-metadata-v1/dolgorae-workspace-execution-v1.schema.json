            "server_epoch": {
              "type": "integer",
              "minimum": 1
            },
            "writer_generation": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
