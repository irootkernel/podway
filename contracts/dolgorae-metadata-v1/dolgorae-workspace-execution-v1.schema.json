      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "accepted_intent_sha256",
        "global_profile_binding_sha256",
        "original_thread_id",
        "run_generation",
        "effective_policy"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae.caller-start-receipt/v1"
