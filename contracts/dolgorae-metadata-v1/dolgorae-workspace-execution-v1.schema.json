    "caller_start_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "created_at",
        "workspace_id",
        "canonical_workspace",
        "workspace_mode",
        "start_baseline",
        "controller",
        "global_profile_binding",
        "request",
        "instructions",
        "readiness"
      ],
      "properties": {
        "run_id": {
          "$ref": "https://dolgorae.local/schema/run-manifest/v2#/properties/run_id"
