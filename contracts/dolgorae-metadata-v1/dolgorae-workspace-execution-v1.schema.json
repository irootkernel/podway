              "$ref": "https://dolgorae.local/schema/specialist-policy-input/v3#/$defs/role_policy/properties/activation_policy"
            },
            "primary_may_request": {
              "$ref": "https://dolgorae.local/schema/specialist-policy-input/v3#/$defs/role_policy/properties/primary_may_request"
            },
