{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolgorae.local/schema/instruction-migration/v1",
  "title": "Explicit legacy instruction and policy authoring migration",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "roles",
        "policies"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae-instruction-migration-request/v1"
        },
        "roles": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "source_sha256",
              "destination_name",
              "publish"
            ],
            "properties": {
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "name"
                ],
                "properties": {
                  "scope": {
                    "enum": [
                      "common",
                      "project"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                    "maxLength": 64
                  }
                }
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "destination_name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "maxLength": 64
              },
              "publish": {
                "type": "boolean"
              }
            }
          }
        },
        "policies": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_file",
              "source_sha256",
              "destination_file",
              "access"
            ],
            "properties": {
              "source_file": {
                "type": "string",
                "pattern": "^/",
                "minLength": 2,
                "x-maxUtf8Bytes": 8192
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "destination_file": {
                "type": "string",
                "pattern": "^/",
                "minLength": 2,
                "x-maxUtf8Bytes": 8192
              },
              "access": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "role_ref",
                    "allowed_access"
                  ],
                  "properties": {
                    "role_ref": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                      "maxLength": 64
                    },
                    "allowed_access": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 2,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "read_only",
                          "canonical_workspace_write"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "roles": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "policies": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "roles",
        "policy"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae-instruction-migration-plan/v1"
        },
        "roles": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "source_sha256",
              "destination_name",
              "destination_exists",
              "name_collision"
            ],
            "properties": {
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "name"
                ],
                "properties": {
                  "scope": {
                    "enum": [
                      "common",
                      "project"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                    "maxLength": 64
                  }
                }
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "destination_name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "maxLength": 64
              },
              "destination_exists": {
                "type": "boolean"
              },
              "name_collision": {
                "type": "boolean"
              }
            }
          }
        },
        "policy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_sha256",
                "policy_name",
                "role_sources"
              ],
              "properties": {
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "policy_name": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                  "maxLength": 64
                },
                "role_sources": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "scope",
                      "name"
                    ],
                    "properties": {
                      "scope": {
                        "enum": [
                          "common",
                          "project"
                        ]
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                        "maxLength": 64
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "published_roles",
        "published_policy_count",
        "sources_retained",
        "accepted_snapshots_changed"
      ],
      "properties": {
        "schema": {
          "const": "dolgorae-instruction-migration-result/v1"
        },
        "published_roles": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "maxLength": 64
          }
        },
        "published_policy_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "sources_retained": {
          "const": true
        },
        "accepted_snapshots_changed": {
          "const": false
        }
      }
    }
  }
}
