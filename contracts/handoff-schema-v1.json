{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "digest",
        "kind",
        "name",
        "version"
      ],
      "type": "object"
    },
    "consumer_proof": {
      "additionalProperties": false,
      "properties": {
        "consumer": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_-]*$",
          "type": "string"
        },
        "proof_refs": {
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "consumer",
        "proof_refs"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "evidence_ref": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "location": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "digest",
        "kind",
        "location"
      ],
      "type": "object"
    },
    "invalidation": {
      "additionalProperties": false,
      "properties": {
        "affected_phases": {
          "items": {
            "pattern": "^(0[A-C]|[1-8]|RC)$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "change_refs": {
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "type": "array",
          "uniqueItems": true
        },
        "requires_0c_replay": {
          "type": "boolean"
        },
        "requires_downstream_replay": {
          "type": "boolean"
        },
        "requires_rc_replay": {
          "type": "boolean"
        }
      },
      "required": [
        "affected_phases",
        "change_refs",
        "requires_0c_replay",
        "requires_downstream_replay",
        "requires_rc_replay"
      ],
      "type": "object"
    },
    "prerequisite": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "receipt_identity": {
          "$ref": "#/$defs/receipt_identity"
        }
      },
      "required": [
        "digest",
        "receipt_identity"
      ],
      "type": "object"
    },
    "producer_proof": {
      "additionalProperties": false,
      "properties": {
        "producer": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_-]*$",
          "type": "string"
        },
        "proof_refs": {
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "producer",
        "proof_refs"
      ],
      "type": "object"
    },
    "receipt_identity": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "podway.canonical-json/v1"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "const": "content-addressed"
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "digest",
        "kind"
      ],
      "type": "object"
    },
    "reviewer": {
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "role"
      ],
      "type": "object"
    }
  },
  "$id": "urn:podway:schema:handoff-receipt:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance": {
      "enum": [
        "accepted",
        "unaccepted"
      ]
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "consumer_proofs": {
      "items": {
        "$ref": "#/$defs/consumer_proof"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "enabled_gates": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Z0-9][A-Z0-9._-]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "invalidation": {
      "$ref": "#/$defs/invalidation"
    },
    "phase": {
      "const": "0C"
    },
    "prerequisites": {
      "items": {
        "$ref": "#/$defs/prerequisite"
      },
      "type": "array",
      "uniqueItems": true
    },
    "producer_proof": {
      "$ref": "#/$defs/producer_proof"
    },
    "receipt_identity": {
      "$ref": "#/$defs/receipt_identity"
    },
    "reviewers": {
      "items": {
        "$ref": "#/$defs/reviewer"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "podway.handoff-receipt/v1"
    }
  },
  "required": [
    "acceptance",
    "artifact",
    "consumer_proofs",
    "enabled_gates",
    "invalidation",
    "phase",
    "prerequisites",
    "producer_proof",
    "receipt_identity",
    "reviewers",
    "schema_version"
  ],
  "title": "Podway Phase 0C Handoff Receipt v1",
  "type": "object"
}
